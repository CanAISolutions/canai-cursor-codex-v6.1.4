{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Evolution Map",
  "description": "Tracks the evolution and branching of prompts in the CanAI system",
  "version": "6.2.1",
  
  "definitions": {
    "PromptVersion": {
      "type": "object",
      "required": ["version", "timestamp", "author", "changes", "metrics"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["enhancement", "fix", "refactor", "deprecation"]
              },
              "description": {
                "type": "string"
              },
              "impact": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["trustScore", "memoryFidelity", "emotionalResonance"],
          "properties": {
            "trustScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "memoryFidelity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "emotionalResonance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    
    "PromptBranch": {
      "type": "object",
      "required": ["name", "baseVersion", "currentVersion", "versions"],
      "properties": {
        "name": {
          "type": "string"
        },
        "baseVersion": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "currentVersion": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PromptVersion"
          }
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "experimental"]
        }
      }
    }
  },
  
  "type": "object",
  "required": ["prompts", "lastUpdated"],
  "properties": {
    "prompts": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "required": ["name", "type", "branches"],
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": ["business_plan", "email_campaign", "social_content", "site_audit", "ai_blueprint", "ai_brand_identity", "reverse_strategy", "profile_makeover", "blogblitz", "ad_amplify", "sparksplit"]
            },
            "branches": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PromptBranch"
              }
            },
            "activeBranch": {
              "type": "string"
            },
            "metrics": {
              "type": "object",
              "required": ["averageTrustScore", "averageMemoryFidelity"],
              "properties": {
                "averageTrustScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "averageMemoryFidelity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "totalVersions": {
                  "type": "integer",
                  "minimum": 0
                },
                "lastUpdate": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    }
  }
} 