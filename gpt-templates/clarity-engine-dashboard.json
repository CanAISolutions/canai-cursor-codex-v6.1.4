{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clarity Engine Dashboard Schema",
  "version": "6.2.1",
  "type": "object",
  "required": ["coreMetrics", "driftTrends", "personaImpact", "actionQueue", "metadata"],
  "properties": {
    "coreMetrics": {
      "type": "object",
      "required": ["healthScore", "trustScore", "memoryFidelity"],
      "properties": {
        "healthScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Overall system health score"
        },
        "trustScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Current trust score"
        },
        "memoryFidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Memory fidelity percentage"
        }
      }
    },
    "driftTrends": {
      "type": "object",
      "required": ["tone", "empathy", "memory", "trust"],
      "properties": {
        "tone": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "value"],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "value": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        },
        "empathy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "value"],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "value": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "value"],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "value": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        },
        "trust": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "value"],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "value": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "personaImpact": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trustScore", "memoryFidelity", "emotionalResonance", "trend"],
        "properties": {
          "trustScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "memoryFidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "emotionalResonance": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "trend": {
            "type": "string",
            "enum": ["improving", "stable", "degrading"]
          }
        }
      }
    },
    "actionQueue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "severity", "status", "description", "impact"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": ["trust", "memory", "cost", "emotional"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed"]
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": "object",
            "required": ["trustScore", "memoryFidelity", "costEfficiency"],
            "properties": {
              "trustScore": {
                "type": "number",
                "minimum": -5,
                "maximum": 5
              },
              "memoryFidelity": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "costEfficiency": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          },
          "assignedTo": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["version", "lastUpdate", "schemaVersion"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "lastUpdate": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    }
  }
} 