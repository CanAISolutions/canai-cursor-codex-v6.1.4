{
  // @codex-purpose: "Define all valid input fields across the system and enforce promptType/enhancer field usage integrity"
  // @codex-system: "Field Validation Engine (Prompt Builder + Enhancer Logic + Snapshot QA)"
  // @codex-critical: "Prevents invalid field references, silent enhancer failures, and schema drift across inputs"
  // @codex-verified: "v1.4.2"

  "fieldMap": [
    {
      "fieldName": "promptType",
      "usedBy": ["all"],
      "required": true,
      "exampleValue": "business_plan"
    },
    {
      "fieldName": "goal",
      "usedBy": ["business_plan", "reverse_strategy", "clarity"],
      "required": true,
      "exampleValue": "launch a wellness app in 90 days"
    },
    {
      "fieldName": "tone",
      "usedBy": ["social_content", "email_campaign", "ai_brand_identity", "tone"],
      "required": false,
      "exampleValue": "confident and approachable"
    },
    {
      "fieldName": "audience",
      "usedBy": ["business_plan", "go_to_market", "pricing_strategy"],
      "required": true,
      "exampleValue": "young professionals experiencing burnout"
    },
    {
      "fieldName": "values",
      "usedBy": ["ai_brand_identity", "emotional_resonance"],
      "required": false,
      "exampleValue": ["transparency", "efficiency", "empathy"]
    },
    {
      "fieldName": "problemArea",
      "usedBy": ["site_audit", "clarity"],
      "required": false,
      "exampleValue": "high bounce rate on pricing page"
    },
    {
      "fieldName": "productTier",
      "usedBy": ["pricing_strategy"],
      "required": false,
      "exampleValue": "starter vs. growth"
    },
    {
      "fieldName": "stretchGoal",
      "usedBy": ["reverse_strategy"],
      "required": true,
      "exampleValue": "become the top 3 mental wellness app in 12 months"
    }
  ],

  "_meta": {
    "description": "Locks the global field registry for prompt input validation, enhancer safety, and snapshot test enforcement. Prevents misnamed fields or unguarded usage.",
    "assert": "matchFieldUsageMap",
    "guardrailFor": "Prompt input contracts, enhancer compatibility, and CI safety",
    "triggerField": "fieldName",
    "snapshotCompatible": true,
    "lastVerifiedAgainst": "v1.4.2"
  }
}
