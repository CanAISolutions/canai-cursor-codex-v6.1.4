// @codex-purpose: Provide a safe, structured test-mode event for CI and automation simulation
// @codex-system: event router + automation dry-run validator
// @codex-critical: Prevents real automations from triggering during test runs or dev flows
// @codex-verified: v1.4.2

{
  "type": "test-trigger",
  "source": "internal",
  "payload": {
    "mode": "test-only",
    "origin": "manual-ci-button",
    "initiatedBy": "developer"
  },
  "_meta": {
    "description": "This event simulates a test-only trigger used in CI pipelines, Make/Zapier test buttons, or manual QA tools. It ensures routing paths work without triggering live automation.",
    "assert": "matchEventShape",
    "triggerField": "mode",
    "guardrailFor": "event-router.ts",
    "routeTo": "test-event-handler.ts",
    "snapshotCompatible": true,
    "lastVerifiedAgainst": "v1.4.2"
  }
}
