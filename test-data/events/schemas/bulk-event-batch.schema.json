{
  // @codex-purpose: Define and enforce the structure of batched event simulations for CI and local QA
  // @codex-system: event-router batch logic + fallback validation
  // @codex-critical: Prevents CI failure drift and protects against no-op test simulation or trigger stalling
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BulkEventBatch",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "bulk-event",
      "description": "Fixed event type for all batch event trigger files"
    },
    "source": {
      "type": "string",
      "enum": ["test", "system", "external"],
      "description": "Where the batch is initiated from"
    },
    "payload": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "A valid event object to be triggered as part of the batch"
          }
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape", "matchErrorStructure"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
