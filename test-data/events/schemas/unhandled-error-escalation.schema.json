{
  // @codex-purpose: Schema for critical escalation events that bypass all known handling paths
  // @codex-system: fallback-monitor.ts + error tracking pipeline
  // @codex-critical: Catches logic holes, prevents dead ends, and ensures alertable error capture
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnhandledErrorEscalationEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "unhandled-error-escalation",
      "description": "Critical failure fallback when no route matches or schema fails"
    },
    "source": {
      "type": "string",
      "enum": ["system"],
      "description": "Always triggered by internal system checks"
    },
    "payload": {
      "type": "object",
      "required": ["sessionId", "errorCode", "severity", "originFile", "timestamp"],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Session during which the unhandled error occurred"
        },
        "errorCode": {
          "type": "string",
          "description": "Internal code identifier for the failure class"
        },
        "severity": {
          "type": "string",
          "enum": ["critical"],
          "description": "All escalations must be 'critical'"
        },
        "originFile": {
          "type": "string",
          "description": "System file or handler where failure was detected"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchErrorStructure"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
