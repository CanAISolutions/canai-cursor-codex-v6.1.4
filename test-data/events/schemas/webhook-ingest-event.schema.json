{
  // @codex-purpose: Schema for general webhook payloads entering the event router
  // @codex-system: event-router.ts + webhook-monitor.ts
  // @codex-critical: Ensures external integrations are safely structured, logged, and routeable
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebhookIngestEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "webhook-ingest",
      "description": "Used to route incoming webhooks into event logic"
    },
    "source": {
      "type": "string",
      "enum": ["external", "webhook"],
      "description": "Identifies the origin of the webhook call"
    },
    "payload": {
      "type": "object",
      "required": ["eventId", "externalSystem", "payloadData", "timestamp"],
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique identifier of the incoming webhook event"
        },
        "externalSystem": {
          "type": "string",
          "description": "Name of the system sending the webhook (e.g., Stripe, Rewardful, Make)"
        },
        "payloadData": {
          "type": "object",
          "description": "Raw data received from the external system"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
