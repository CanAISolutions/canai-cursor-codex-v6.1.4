{
  // @codex-purpose: Schema for detecting fulfillment timeouts and triggering retry fallback
  // @codex-system: timeout-monitor.ts + retry-fulfillment-handler.ts
  // @codex-critical: Prevents silent hangs and ensures recoverability for stalled prompt sessions
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimeoutDetectedEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "timeout-detected",
      "description": "System triggered this event after fulfillment timeout"
    },
    "source": {
      "type": "string",
      "enum": ["system"],
      "description": "Must originate from system watchdog or timeout monitor"
    },
    "payload": {
      "type": "object",
      "required": ["sessionId", "promptType", "timeoutMs", "timestamp"],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "ID of the session that timed out"
        },
        "promptType": {
          "type": "string",
          "description": "Prompt type that failed to return in time"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 5000,
          "description": "Number of milliseconds before timeout was triggered"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
