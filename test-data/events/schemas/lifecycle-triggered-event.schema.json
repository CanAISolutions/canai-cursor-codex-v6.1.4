{
  // @codex-purpose: Schema for internal triggers that launch lifecycle sequences after prompt completion
  // @codex-system: lifecycle-engine.ts + campaign automation trigger logic
  // @codex-critical: Prevents broken or contextless lifecycle execution, especially after fulfillment
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifecycleTriggeredEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "lifecycle-triggered",
      "description": "Triggers internal lifecycle automation sequences"
    },
    "source": {
      "type": "string",
      "enum": ["system", "copilot"],
      "description": "Who initiated the lifecycle (e.g., post-prompt logic)"
    },
    "payload": {
      "type": "object",
      "required": ["promptType", "sessionId", "timestamp"],
      "properties": {
        "promptType": {
          "type": "string",
          "description": "The type of prompt that completed"
        },
        "sessionId": {
          "type": "string",
          "description": "The session that triggered this lifecycle event"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
