{
  // @codex-purpose: Schema for manually simulating event triggers in local or CI environments
  // @codex-system: local QA runner + CLI event simulation tool
  // @codex-critical: Prevents misclassified events and protects real environments from test interference
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventTestTrigger",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "test-trigger",
      "description": "Always 'test-trigger' for manual simulations"
    },
    "source": {
      "type": "string",
      "enum": ["dev", "test"],
      "description": "Denotes this trigger is a non-production simulation"
    },
    "payload": {
      "type": "object",
      "required": ["mode", "triggerId"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["test-only"],
          "description": "Must be 'test-only' to prevent execution in production logic"
        },
        "triggerId": {
          "type": "string",
          "description": "Label or ID describing the test condition being triggered"
        },
        "testScenario": {
          "type": "string",
          "description": "Optional description of the simulated logic being tested"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
