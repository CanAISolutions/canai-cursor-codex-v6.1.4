{
  // @codex-purpose: Schema for retrying a session after failed or incomplete fulfillment
  // @codex-system: retry-fulfillment-handler.ts + SmartPromptScore engine
  // @codex-critical: Prevents infinite retry loops, enables reliable recovery, and logs escalation-worthy retries
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RetryFailedFulfillmentEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "retry-failed-fulfillment",
      "description": "System-detected failure that requires a retry of fulfillment logic"
    },
    "source": {
      "type": "string",
      "enum": ["system", "copilot"],
      "description": "Who initiated the retry (Copilot or fallback system)"
    },
    "payload": {
      "type": "object",
      "required": ["sessionId", "retryCount", "timestamp"],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "ID of the failed fulfillment session to retry"
        },
        "retryCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of times the system has attempted this retry"
        },
        "failureReason": {
          "type": "string",
          "description": "Optional field describing why this session needs retrying"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
