{
  // @codex-purpose: Schema for successful referral conversion events after signup or payment
  // @codex-system: reward-monitor.ts + attribution pipeline
  // @codex-critical: Ensures rewards aren't silently dropped and enables accurate referral attribution
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReferralConversionEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "referral-conversion",
      "description": "Used when a referred user successfully converts (e.g. paid, completed session)"
    },
    "source": {
      "type": "string",
      "enum": ["stripe", "rewardful", "internal"],
      "description": "System that triggered the referral event"
    },
    "payload": {
      "type": "object",
      "required": ["referrerId", "conversionAmount", "timestamp"],
      "properties": {
        "referrerId": {
          "type": "string",
          "description": "Unique ID of the user who made the referral"
        },
        "conversionAmount": {
          "type": "number",
          "minimum": 0.01,
          "description": "Dollar value (or token equivalent) of the successful conversion"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
