{
  // @codex-purpose: Schema for simulating malformed or corrupted events missing required 'type' field
  // @codex-system: validation engine + fallback monitor
  // @codex-critical: Prevents undefined routing and ensures robust schema enforcement
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissingEventTypeSimulation",
  "type": "object",
  "required": ["source", "payload", "_meta"], // 'type' intentionally excluded
  "properties": {
    "source": {
      "type": "string",
      "enum": ["test", "external", "unknown"],
      "description": "Origin of the broken or malformed event"
    },
    "payload": {
      "type": "object",
      "description": "Intentionally unstructured or incomplete event payload"
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchErrorStructure"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
