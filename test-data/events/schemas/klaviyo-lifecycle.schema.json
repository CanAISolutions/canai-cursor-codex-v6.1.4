{
  // @codex-purpose: Schema for simulating inbound Klaviyo lifecycle events (e.g. welcome series)
  // @codex-system: lifecycle automation engine + webhook validator
  // @codex-critical: Prevents silent campaign failures and ensures event payloads are safely attributed
  // @codex-verified: v1.4.2

  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KlaviyoLifecycleEvent",
  "type": "object",
  "required": ["type", "source", "payload", "_meta"],
  "properties": {
    "type": {
      "const": "lifecycle-event",
      "description": "Specifies lifecycle hook type"
    },
    "source": {
      "type": "string",
      "enum": ["klaviyo"],
      "description": "Must be 'klaviyo' to distinguish from internal lifecycle events"
    },
    "payload": {
      "type": "object",
      "required": ["campaignName", "userEmail", "timestamp"],
      "properties": {
        "campaignName": {
          "type": "string",
          "description": "Name of the triggered campaign"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Email address targeted by the campaign"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "description",
        "assert",
        "guardrailFor",
        "triggerField",
        "routeTo",
        "snapshotCompatible",
        "lastVerifiedAgainst"
      ],
      "properties": {
        "description": { "type": "string" },
        "assert": { "type": "string", "enum": ["matchEventShape"] },
        "guardrailFor": { "type": "string" },
        "triggerField": { "type": "string" },
        "routeTo": { "type": "string" },
        "snapshotCompatible": { "type": "boolean" },
        "lastVerifiedAgainst": { "type": "string" }
      }
    }
  }
}
