{
    "scenarios": [
      {
        "name": "Enrich Session with AI Metadata",
        "modules": [
          {
            "id": 1,
            "module": "webhooks.customWebhook",
            "name": "Webhook — Enrich Session",
            "parameters": {
              "hookName": "canai-enrich-session"
            }
          },
          {
            "id": 2,
            "module": "airtable.updateRecord",
            "name": "Airtable — Update Session Record",
            "parameters": {
              "baseId": "appXXXXXXXXXXXXXX",
              "tableId": "tblSessionAnalyticsXXXXXXXX",
              "recordId": "{{1.recordId}}",
              "fields": {
                "SmartPromptScore": "{{1.smartScore}}",
                "EmotionalTone": "{{1.tone}}",
                "RevisionDepth": "{{1.revisionLevel}}",
                "TokensUsed": "{{1.tokens}}"
              }
            }
          },
          {
            "id": 3,
            "module": "webhooks.webhookResponse",
            "name": "Respond to Enrichment",
            "parameters": {
              "status": 200,
              "body": "✅ Session enriched"
            }
          }
        ]
      }
    ]
  }
  