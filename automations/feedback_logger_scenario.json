{
    "scenarios": [
      {
        "name": "Log Feedback to Airtable",
        "modules": [
          {
            "id": 1,
            "module": "webhooks.customWebhook",
            "name": "Webhook — Capture Feedback",
            "parameters": {
              "hookName": "canai-feedback"
            }
          },
          {
            "id": 2,
            "module": "airtable.createRecord",
            "name": "Airtable — Save Feedback",
            "parameters": {
              "baseId": "appXXXXXXXXXXXXXX",
              "tableId": "tblFeedbackLogsXXXXXXXX",
              "fields": {
                "PromptType": "{{1.promptType}}",
                "Feedback": "{{1.feedback}}",
                "Rating": "{{1.rating}}",
                "SessionID": "{{1.sessionId}}",
                "UserID": "{{1.userId}}",
                "SubmittedAt": "{{now}}"
              }
            }
          },
          {
            "id": 3,
            "module": "webhooks.webhookResponse",
            "name": "Respond to Feedback",
            "parameters": {
              "status": 200,
              "body": "✅ Feedback logged. Thank you!"
            }
          }
        ]
      }
    ]
  }
  