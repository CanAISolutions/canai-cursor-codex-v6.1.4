{
    "scenarios": [
      {
        "name": "Log Session Analytics",
        "modules": [
          {
            "id": 1,
            "module": "webhooks.customWebhook",
            "name": "Webhook — Session Log",
            "parameters": {
              "hookName": "canai-session-logger"
            }
          },
          {
            "id": 2,
            "module": "airtable.createRecord",
            "name": "Airtable — Save Session",
            "parameters": {
              "baseId": "appXXXXXXXXXXXXXX",
              "tableId": "tblSessionAnalyticsXXXXXXXX",
              "fields": {
                "SessionID": "{{1.sessionId}}",
                "PromptType": "{{1.promptType}}",
                "TokensUsed": "{{1.tokens}}",
                "RevisionCount": "{{1.revisionCount}}",
                "UserID": "{{1.userId}}",
                "LoggedAt": "{{now}}"
              }
            }
          },
          {
            "id": 3,
            "module": "webhooks.webhookResponse",
            "name": "Confirm Session Log",
            "parameters": {
              "status": 200,
              "body": "✅ Session analytics saved."
            }
          }
        ]
      }
    ]
  }
  