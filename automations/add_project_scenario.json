{
    "scenarios": [
      {
        "name": "Add Project to Airtable",
        "modules": [
          {
            "id": 1,
            "module": "webhooks.customWebhook",
            "name": "Webhook — Add Project",
            "parameters": {
              "hookName": "canai-add-project"
            }
          },
          {
            "id": 2,
            "module": "airtable.createRecord",
            "name": "Airtable — Create Project",
            "parameters": {
              "baseId": "appXXXXXXXXXXXXXX",
              "tableId": "tblProjectsXXXXXXXX",
              "fields": {
                "PromptType": "{{1.promptType}}",
                "Input": "{{1.input}}",
                "UserID": "{{1.userId}}",
                "SessionID": "{{1.sessionId}}",
                "Status": "Submitted"
              }
            }
          },
          {
            "id": 3,
            "module": "tools.sleep",
            "name": "Wait 2 Seconds",
            "parameters": {
              "duration": 2
            }
          },
          {
            "id": 4,
            "module": "webhooks.webhookResponse",
            "name": "Respond to Webhook",
            "parameters": {
              "status": 200,
              "body": "✅ Project logged successfully"
            }
          }
        ]
      }
    ]
  }
  