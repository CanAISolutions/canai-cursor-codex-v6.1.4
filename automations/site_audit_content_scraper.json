{
  "scenarios": [
    {
      "name": "site_audit_content_scraper",
      "modules": [
        {
          "id": 1,
          "module": "webhooks.customWebhook",
          "name": "Receive Site Audit Request",
          "parameters": {
            "hookName": "canai-site-audit"
          }
        },
        {
          "id": 2,
          "module": "http.makeRequest",
          "name": "Scrape Website Content",
          "parameters": {
            "method": "GET",
            "url": "{{1.url}}",
            "headers": {
              "User-Agent": "CanAI-AuditBot"
            }
          }
        },
        {
          "id": 3,
          "module": "tools.textParser",
          "name": "Extract Main Content (Regex)",
          "parameters": {
            "text": "{{2.data}}",
            "regex": "<main[^>]*>(.*?)</main>",
            "mode": "firstMatch"
          }
        },
        {
          "id": 4,
          "module": "text.htmlToText",
          "name": "Clean HTML to Text",
          "parameters": {
            "html": "{{3.match}}"
          }
        },
        {
          "id": 5,
          "module": "airtable.updateRecord",
          "name": "Enrich Airtable Record with Content",
          "parameters": {
            "baseId": "appXXXXXXXXXXXXXX",
            "tableId": "tblProjectsXXXXXXXX",
            "recordId": "{{1.recordId}}",
            "fields": {
              "customerContent": "{{4.text}}"
            }
          }
        },
        {
          "id": 6,
          "module": "webhooks.webhookResponse",
          "name": "Confirm Completion",
          "parameters": {
            "status": 200,
            "body": "\u2705 Content scraped and prompt enriched"
          }
        }
      ]
    }
  ]
}