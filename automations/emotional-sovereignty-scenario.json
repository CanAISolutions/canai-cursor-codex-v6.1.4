{
  "name": "Emotional Sovereignty - Complete Project Creation",
  "description": "Enhanced scenario with emotional intelligence, spark resonance, and trust building",
  "version": "v2.1.0",
  "webhook": "https://hook.us1.make.com/emotional-sovereignty",
  "modules": [
    {
      "id": 1,
      "module": "webhooks.customWebhook",
      "name": "Receive User Input",
      "parameters": {
        "hookName": "emotional-sovereignty-input"
      },
      "metadata": {
        "description": "Receives user input from Discovery Funnel with emotional context"
      }
    },
    {
      "id": 2,
      "module": "http.makeRequest",
      "name": "Process Emotional Sovereignty",
      "parameters": {
        "url": "{{BACKEND_URL}}/api/webhook/emotional-sovereignty-bridge",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{API_KEY}}"
        },
        "body": {
          "userInput": "{{1.userInput}}",
          "sessionId": "{{1.sessionId}}",
          "userId": "{{1.userId}}",
          "productType": "{{1.productType}}",
          "context": "{{1.context}}",
          "timestamp": "{{now}}"
        }
      },
      "metadata": {
        "description": "Processes input through emotional sovereignty orchestrator"
      }
    },
    {
      "id": 3,
      "module": "airtable.createRecord",
      "name": "Log Emotional Sovereignty Session",
      "parameters": {
        "baseId": "{{AIRTABLE_BASE_ID}}",
        "tableId": "tblEmotionalSovereignty",
        "fields": {
          "SessionID": "{{2.sessionId}}",
          "ProductType": "{{2.makeWebhookData.productType}}",
          "StructuredIntent": "{{2.structuredIntent}}",
          "EmotionalContext": "{{2.emotionalContext}}",
          "SparkResonance": "{{2.sparkResonance.overallResonance}}",
          "SelectedSparkName": "{{2.sparkResonance.selectedSpark.personalizedName}}",
          "EmotionalArcType": "{{2.emotionalArc.arcType}}",
          "StartTrustScore": "{{2.emotionalArc.startTrustScore}}",
          "FinalTrustScore": "{{2.emotionalArc.finalTrustScore}}",
          "EmotionalDelta": "{{2.emotionalArc.emotionalDelta}}",
          "UsedEmotionalMemory": "{{2.emotionalContext.hasHistory}}",
          "LanguageFingerprint": "{{2.emotionalContext.languageFingerprint}}",
          "ReadyForExecution": "{{2.readyForExecution}}",
          "ProcessedAt": "{{now}}",
          "Status": "{{if(2.readyForExecution, 'Ready', 'Needs Review')}}"
        }
      },
      "metadata": {
        "description": "Logs complete emotional sovereignty data to Airtable"
      }
    },
    {
      "id": 4,
      "module": "conditional",
      "name": "Check Trust Score",
      "condition": "{{2.emotionalArc.finalTrustScore}} >= 4.2",
      "metadata": {
        "description": "Routes based on emotional trust score threshold"
      }
    },
    {
      "id": 5,
      "module": "openai.createCompletion",
      "name": "Generate High-Trust Content",
      "condition": "{{4.result}} = true",
      "parameters": {
        "model": "{{selectEmotionalModel(2.emotionalArc.finalTrustScore)}}",
        "prompt": "{{buildEmotionallyAwarePrompt(2)}}",
        "temperature": "{{calculateEmotionalTemperature(2.emotionalContext)}}",
        "max_tokens": 1500,
        "metadata": {
          "sessionId": "{{2.sessionId}}",
          "emotionalArcType": "{{2.emotionalArc.arcType}}",
          "sparkResonance": "{{2.sparkResonance.overallResonance}}"
        }
      },
      "metadata": {
        "description": "Generates content with high emotional trust optimization"
      }
    },
    {
      "id": 6,
      "module": "http.makeRequest",
      "name": "Trigger Emotional Recovery",
      "condition": "{{4.result}} = false",
      "parameters": {
        "url": "{{BACKEND_URL}}/api/emotional/recovery-flow",
        "method": "POST",
        "body": {
          "sessionId": "{{2.sessionId}}",
          "trustScore": "{{2.emotionalArc.finalTrustScore}}",
          "emotionalArcType": "{{2.emotionalArc.arcType}}",
          "recoveryNeeded": true,
          "context": "{{2.emotionalContext}}"
        }
      },
      "metadata": {
        "description": "Triggers emotional recovery flow for low trust scores"
      }
    },
    {
      "id": 7,
      "module": "webflow.createCMSItem",
      "name": "Create Emotionally Sovereign Content",
      "condition": "{{4.result}} = true",
      "parameters": {
        "collectionId": "656e1c9b3bfbb19ab1db44f6",
        "fields": {
          "name": "{{2.sparkResonance.selectedSpark.personalizedName}}",
          "slug": "{{generateEmotionalSlug(2.sessionId, 2.emotionalArc.arcType)}}",
          "content": "{{5.choices[0].text}}",
          "emotional-trust-score": "{{2.emotionalArc.finalTrustScore}}",
          "emotional-arc-type": "{{2.emotionalArc.arcType}}",
          "spark-resonance": "{{2.sparkResonance.overallResonance}}",
          "used-emotional-memory": "{{2.emotionalContext.hasHistory}}",
          "emotional-hook": "{{2.sparkResonance.selectedSpark.emotionalHook}}",
          "trust-delta": "{{2.emotionalArc.emotionalDelta}}",
          "session-id": "{{2.sessionId}}",
          "product-type": "{{2.makeWebhookData.productType}}",
          "created-at": "{{now}}"
        }
      },
      "metadata": {
        "description": "Creates Webflow CMS item with emotional sovereignty data"
      }
    },
    {
      "id": 8,
      "module": "conditional",
      "name": "Check for Celebration",
      "condition": "{{2.emotionalArc.finalTrustScore}} > 4.5 AND {{2.emotionalArc.emotionalDelta}} > 0.5",
      "metadata": {
        "description": "Determines if user deserves celebration email"
      }
    },
    {
      "id": 9,
      "module": "email.sendEmail",
      "name": "Send Celebration Email",
      "condition": "{{8.result}} = true",
      "parameters": {
        "to": "{{1.email}}",
        "subject": "Your {{2.sparkResonance.selectedSpark.personalizedName}} is Ready to Shine ✨",
        "body": "{{buildCelebratoryEmail(2)}}",
        "metadata": {
          "emotionalArcType": "{{2.emotionalArc.arcType}}",
          "trustScore": "{{2.emotionalArc.finalTrustScore}}",
          "sparkName": "{{2.sparkResonance.selectedSpark.personalizedName}}"
        }
      },
      "metadata": {
        "description": "Sends celebratory email for high-trust, high-delta sessions"
      }
    },
    {
      "id": 10,
      "module": "airtable.updateRecord",
      "name": "Update Session with Results",
      "parameters": {
        "baseId": "{{AIRTABLE_BASE_ID}}",
        "tableId": "tblEmotionalSovereignty",
        "recordId": "{{3.id}}",
        "fields": {
          "GeneratedContent": "{{if(4.result, 5.choices[0].text, 'Recovery Triggered')}}",
          "WebflowItemId": "{{if(4.result, 7.id, '')}}",
          "CelebrationSent": "{{if(8.result, 'Yes', 'No')}}",
          "FinalStatus": "{{if(4.result, 'Completed', 'Recovery')}}",
          "CompletedAt": "{{now}}"
        }
      },
      "metadata": {
        "description": "Updates Airtable record with final results"
      }
    },
    {
      "id": 11,
      "module": "webhooks.webhookResponse",
      "name": "Return Success Response",
      "parameters": {
        "status": 200,
        "body": {
          "success": true,
          "sessionId": "{{2.sessionId}}",
          "emotionalTrustScore": "{{2.emotionalArc.finalTrustScore}}",
          "emotionalArcType": "{{2.emotionalArc.arcType}}",
          "sparkResonance": "{{2.sparkResonance.overallResonance}}",
          "contentGenerated": "{{4.result}}",
          "celebrationSent": "{{8.result}}",
          "webflowUrl": "{{if(4.result, 'https://canai.io/projects/' + 7.slug, '')}}",
          "message": "{{if(4.result, 'Your ' + 2.sparkResonance.selectedSpark.personalizedName + ' is ready!', 'We're refining your vision - check back soon.')}}",
          "timestamp": "{{now}}"
        }
      },
      "metadata": {
        "description": "Returns comprehensive response with emotional sovereignty results"
      }
    }
  ],
  "errorHandling": {
    "fallbackResponse": {
      "status": 200,
      "body": {
        "success": false,
        "fallback": true,
        "message": "We're processing your request with extra care.",
        "sessionId": "{{1.sessionId}}",
        "timestamp": "{{now}}"
      }
    },
    "retryPolicy": {
      "maxRetries": 3,
      "retryDelay": 2000
    }
  },
  "monitoring": {
    "trackEmotionalMetrics": true,
    "alertOnLowTrust": true,
    "logAllInteractions": true
  }
} 