{
    "scenarios": [
      {
        "name": "Send Output Email to User",
        "modules": [
          {
            "id": 1,
            "module": "webhooks.customWebhook",
            "name": "Webhook — Trigger Output Email",
            "parameters": {
              "hookName": "canai-send-output"
            }
          },
          {
            "id": 2,
            "module": "email.sendEmail",
            "name": "Send Email to User",
            "parameters": {
              "to": "{{1.email}}",
              "subject": "Your CanAI Output is Ready 🎉",
              "body": "**Hello!**\n\nYour requested output is ready:\n\n{{1.output}}\n\n---\nNeed edits? Just reply or submit feedback.\n\n_The CanAI Team_"
            }
          },
          {
            "id": 3,
            "module": "webhooks.webhookResponse",
            "name": "Confirm Email Sent",
            "parameters": {
              "status": 200,
              "body": "✅ Output email sent."
            }
          }
        ]
      }
    ]
  }
  