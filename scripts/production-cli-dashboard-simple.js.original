    console.log('  \\i scripts/deploy-jsonb-optimization.sql');
    console.log('');
    console.log('  # Deploy SQL intelligence');
    console.log('  \\i scripts/deploy-sql-intelligence.sql');
    console.log('');
    console.log('  # Test deployment');
