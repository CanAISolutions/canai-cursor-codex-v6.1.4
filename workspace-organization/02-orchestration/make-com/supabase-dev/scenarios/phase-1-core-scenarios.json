  ],
  
  "core_scenarios": {
    "scenario_1_prompt_logs": {
      "name": "Prompt Logs Core Integration",
      "description": "Foundation scenario for all AI interaction logging with trust score tracking",
      "priority": "critical",
      "week": 1,
      "day": "1-2",
      "modules": [
        {
          "id": 1,
          "type": "Webhooks",
          "name": "Receive Prompt Log",
          "description": "Accept incoming AI interaction data",
          "settings": {
            "webhook_name": "prompt-logs-receiver",
            "webhook_url": "/webhook/prompt-logs",
            "method": "POST",
            "data_structure": "JSON",
            "authentication": "API_KEY"
          },
          "data_validation": {
            "required_fields": [
              "sessionId",
              "userId", 
              "promptType",
              "input",
              "output",
              "trustScore"
            ],
            "emotional_validation": true,
            "trust_threshold": 4.2
          }
        },
        {
          "id": 2,
          "type": "Router",
          "name": "Trust Score Assessment",
          "description": "Route based on trust score for appropriate processing",
          "routes": [
            {
              "condition": "{{1.trustScore}} >= 4.2",
              "name": "Standard Processing",
              "next_module": 3
            },
            {
              "condition": "{{1.trustScore}} >= 3.0 AND {{1.trustScore}} < 4.2",
              "name": "Enhanced Processing", 
              "next_module": 4
            },
            {
              "condition": "{{1.trustScore}} < 3.0",
              "name": "Emotional Recovery",
              "next_module": 5
            }
          ]
        },
        {
          "id": 3,
          "type": "JSON",
          "name": "Transform Standard Data",
          "description": "Structure data for standard Supabase insertion",
          "transformation": {
            "session_id": "{{1.sessionId}}",
            "user_id": "{{1.userId}}",
            "prompt_type": "{{1.promptType}}",
            "input": "{{1.input}}",
            "output": "{{1.output}}",
            "trust_score": "{{1.trustScore}}",
            "sacred_reversal_passed": "{{1.sacredReversalPassed}}",
            "user_empowerment_increased": "{{1.userEmpowermentIncreased}}",
            "emotional_sovereignty_preserved": "{{1.emotionalSovereigntyPreserved}}",
            "created_at": "{{now}}",
            "updated_at": "{{now}}"
          }
        },
        {
          "id": 4,
          "type": "JSON", 
          "name": "Transform Enhanced Data",
          "description": "Structure data with enhanced processing flags",
          "transformation": {
            "session_id": "{{1.sessionId}}",
            "user_id": "{{1.userId}}",
            "prompt_type": "{{1.promptType}}",
            "input": "{{1.input}}",
            "output": "{{1.output}}",
            "trust_score": "{{1.trustScore}}",
            "processing_type": "enhanced",
            "enhancement_reason": "trust_score_between_3_and_4.2",
            "sacred_reversal_passed": "{{1.sacredReversalPassed}}",
            "user_empowerment_increased": "{{1.userEmpowermentIncreased}}",
            "emotional_sovereignty_preserved": "{{1.emotionalSovereigntyPreserved}}",
            "created_at": "{{now}}",
            "updated_at": "{{now}}"
          }
        },
        {
          "id": 5,
          "type": "JSON",
          "name": "Transform Recovery Data",
          "description": "Structure data with emotional recovery flags",
          "transformation": {
            "session_id": "{{1.sessionId}}",
            "user_id": "{{1.userId}}",
            "prompt_type": "{{1.promptType}}",
            "input": "{{1.input}}",
            "output": "{{1.output}}",
            "trust_score": "{{1.trustScore}}",
            "processing_type": "emotional_recovery",
            "recovery_triggered": true,
            "sacred_reversal_passed": false,
            "user_empowerment_increased": "{{1.userEmpowermentIncreased}}",
            "emotional_sovereignty_preserved": "{{1.emotionalSovereigntyPreserved}}",
            "created_at": "{{now}}",
            "updated_at": "{{now}}"
          }
        },
        {
          "id": 6,
          "type": "Supabase",
          "name": "Insert Prompt Log",
          "description": "Store processed data in Supabase prompt_logs table",
          "settings": {
            "connection": "supabase_canai",
            "table": "prompt_logs",
            "operation": "INSERT",
            "data": "{{previous_module_output}}"
          },
          "error_handling": {
            "retry_attempts": 3,
            "timeout": 30000,
            "fallback_action": "log_to_error_table"
          }
        },
        {
          "id": 7,
          "type": "HTTP",
          "name": "Trigger Analytics Update",
          "description": "Notify analytics system of new prompt log",
          "settings": {
            "url": "{{env.ANALYTICS_WEBHOOK_URL}}/prompt-log-created",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer {{env.ANALYTICS_API_KEY}}",
              "Content-Type": "application/json"
            },
            "body": {
              "sessionId": "{{1.sessionId}}",
              "userId": "{{1.userId}}",
              "trustScore": "{{1.trustScore}}",
              "timestamp": "{{now}}"
            }
          }
        }
      ],
      "success_criteria": [
        "Webhook receives data successfully",
        "Trust score routing works correctly", 
        "Data transformation preserves emotional sovereignty fields",
        "Supabase insertion completes without errors",
        "Analytics notification sent successfully"
      ]
    },
    
    "scenario_2_user_context": {
      "name": "User Context Integration",
      "description": "Comprehensive user intelligence and personalization data processing",
      "priority": "critical",
      "week": 1,
      "day": "3-4",
      "modules": [
        {
          "id": 1,
          "type": "Webhooks",
          "name": "Receive User Context",
          "description": "Accept user intelligence and context data",
          "settings": {
            "webhook_name": "user-context-receiver",
            "webhook_url": "/webhook/user-context",
            "method": "POST",
            "data_structure": "JSON",
            "authentication": "API_KEY"
          },
          "data_validation": {
            "required_fields": [
              "userId",
              "profile",
              "preferences", 
              "emotionalState",
              "trustProfile"
            ],
            "emotional_validation": true,
            "trust_threshold": 4.2
          }
        },
        {
          "id": 2,
          "type": "JSON",
          "name": "Validate Emotional Sovereignty",
          "description": "Ensure user context honors emotional sovereignty",
          "validation": {
            "sacred_reversal_passed": "{{1.sacredReversalPassed}}",
            "user_empowerment_increased": "{{1.userEmpowermentIncreased}}",
            "emotional_sovereignty_preserved": "{{1.emotionalSovereigntyPreserved}}",
            "trust_score": "{{1.trustScore}}"
          },
          "transformation": {
            "user_id": "{{1.userId}}",
            "profile": "{{1.profile}}",
            "preferences": "{{1.preferences}}",
            "emotional_state": "{{1.emotionalState}}",
            "trust_profile": "{{1.trustProfile}}",
            "sovereignty_validation": {
              "sacred_reversal_passed": "{{1.sacredReversalPassed}}",
              "user_empowerment_increased": "{{1.userEmpowermentIncreased}}",
              "emotional_sovereignty_preserved": "{{1.emotionalSovereigntyPreserved}}"
            },
            "trust_score": "{{1.trustScore}}",
            "created_at": "{{now}}",
            "updated_at": "{{now}}"
          }
        },
        {
          "id": 3,
          "type": "Supabase",
          "name": "Upsert User Context",
          "description": "Insert or update user context in Supabase",
          "settings": {
            "connection": "supabase_canai",
            "table": "user_context",
            "operation": "UPSERT",
            "conflict_target": "user_id",
            "data": "{{2.output}}"
          }
        },
        {
          "id": 4,
          "type": "HTTP",
          "name": "Update Personalization Engine",
          "description": "Notify personalization system of context update",
          "settings": {
            "url": "{{env.PERSONALIZATION_WEBHOOK_URL}}/context-updated",
            "method": "POST",
            "body": {
              "userId": "{{1.userId}}",
              "trustScore": "{{1.trustScore}}",
              "emotionalState": "{{1.emotionalState}}",
              "timestamp": "{{now}}"
            }
          }
        }
      ]
    },
    
