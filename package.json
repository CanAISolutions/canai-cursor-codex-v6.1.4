{
  "name": "canai-cursor-codex",
  "version": "6.1.4",
  "description": "Clarity Simulation System (CBSE v2.5)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node scripts/run-simulations.ts",
    "test": "jest",
    "test:ci": "jest tests/ci",
    "test:metrics": "ts-node cursor/scripts/run-metric-tests.ts",
    "test-first-truth": "ts-node scripts/test-first-truth-validator.ts",
    "test-first-truth:validate": "ts-node scripts/test-first-truth-validator.ts validate",
    "test-first-truth:project": "ts-node scripts/test-first-truth-validator.ts project",
    "test-first-truth:report": "ts-node scripts/test-first-truth-validator.ts report",
    "test:airtable-mvp": "ts-node scripts/tools/test-airtable-form-mvp.ts",
    "test:webhook-integration": "ts-node scripts/tools/test-airtable-form-mvp.ts",
    "test:make-scenarios": "ts-node api/services/make-webhook-tester.ts",
    "test:mvp-flow": "npm run test:airtable-mvp && npm run test:make-scenarios",
    "test:airtable-api": "node infra/airtable/run-airtable-tests.js",
    "test:airtable-crud": "node infra/airtable/run-airtable-tests.js",
    "test:airtable-fields": "ts-node infra/airtable/test-airtable-crud-operations.ts",
    "validate:airtable": "npm run test:airtable-api",
    "discover:airtable": "node infra/airtable/complete-base-discovery.js",
    "discover:airtable-full": "node infra/airtable/complete-base-discovery.js",
    "dreamstate:protect": "ts-node cursor/scripts/dreamstate-protection-guard.ts",
    "dreamstate:test": "npm test tests/dreamstate",
    "precommit": "npm run dreamstate:protect && npm run test-first-truth:project && npm run enforce-mdc -- --dir cursor --strict && npm run detect-placeholders -- --fail-on-critical",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "dreamstate-hash": "node cursor/scripts/hash-dreamstate.ts",
    "sentinel:check": "node cursor/agents/sentinel-prime/index.ts",
    "community:align": "node cursor/community/alignment-score.ts",
    "mdc:activate": "ts-node cursor/boot_sequence/00_mdc_rules_activation.ts",
    "enforce-mdc": "node cursor/scripts/enforce-mdc.js",
    "enforce-mdc:fix": "node cursor/scripts/enforce-mdc.js --fix",
    "enforce-mdc:report": "node cursor/scripts/enforce-mdc.js --dir cursor --report mdc-report.txt",
    "enforce-mdc:ci": "node cursor/scripts/enforce-mdc.js --dir cursor --strict",
    "detect-placeholders": "node scripts/tools/detect-placeholder-implementations.js",
    "detect-placeholders:fix": "node scripts/tools/detect-placeholder-implementations.js --suggest-fixes",
    "detect-placeholders:update": "node scripts/tools/detect-placeholder-implementations.js --update-registry",
    "detect-placeholders:report": "node scripts/tools/detect-placeholder-implementations.js --output placeholder-report.json",
    "detect-placeholders:ci": "node scripts/tools/detect-placeholder-implementations.js --fail-on-critical --ci",
    "update-placeholder-registry": "node scripts/tools/detect-placeholder-implementations.js --update-registry",
    "create-placeholder-tasks": "node scripts/tools/detect-placeholder-implementations.js --create-tasks",
    "validate:csv:all": "ts-node scripts/tools/csv-accuracy-validator.ts --all",
    "validate:csv:promptlogs": "ts-node scripts/tools/csv-accuracy-validator.ts --file=01_PromptLogs.csv",
    "validate:csv:sparksplit": "ts-node scripts/tools/csv-accuracy-validator.ts --file=02_SparkSplitAnalytics.csv",
    "validate:csv:session": "ts-node scripts/tools/csv-accuracy-validator.ts --file=03_SessionAnalytics.csv",
    "boot": "ts-node cursor/boot_sequence/index.ts",
    "prestart": "npm run boot",
    "predev": "npm run boot",
    "test:integration": "node scripts/validate-integration-completeness.js",
    "test:integration:foundation": "node test-emotional-api.js",
    "test:integration:core": "echo 'Core integration tests not yet implemented'",
    "test:integration:database": "echo 'Database integration tests not yet implemented'",
    "test:integration:advanced": "echo 'Advanced integration tests not yet implemented'",
    "test:integration:production": "echo 'Production integration tests not yet implemented'",
    "test:emotional:all": "npm run test:integration && npm run dreamstate:test",
    "validate:integration": "node scripts/validate-integration-completeness.js",
    "integration:status": "node scripts/integration-status-summary.js",
    "integration:update-tracker": "node scripts/validate-integration-completeness.js",
    "dreamstate:task-runner": "node scripts/dreamstate-task-runner.js",
    "dreamstate:next-task": "node scripts/dreamstate-task-runner.js",
    "tracker:update": "node scripts/update-tracker.js update",
    "tracker:test": "node scripts/update-tracker.js test",
    "tracker:complete": "node scripts/update-tracker.js complete",
    "tracker:phase": "node scripts/update-tracker.js phase",
    "tracker:report": "node scripts/update-tracker.js report",
    "phase1:start": "npm run tracker:phase \"Phase 1\" \"🔄 IN PROGRESS\" 0 && echo 'Phase 1 started - run individual tests with npm run phase1:test-*'",
    "phase1:test-form": "npm test -- --testNamePattern=\"form.*submission\" && npm run tracker:complete \"Form Submission Test\"",
    "phase1:test-intent": "npm test -- --testNamePattern=\"intent.*mirror\" && npm run tracker:complete \"Intent Mirror Test\"",
    "phase1:test-scenario": "npm test -- --testNamePattern=\"scenario.*routing\" && npm run tracker:complete \"Scenario Routing Test\"",
    "phase1:test-trust": "npm test -- --testNamePattern=\"trust.*monitoring\" && npm run tracker:complete \"Trust Monitoring Test\"",
    "phase1:test-recovery": "npm test -- --testNamePattern=\"error.*recovery\" && npm run tracker:complete \"Error Recovery Test\"",
    "phase1:test-performance": "npm run test:performance && npm run tracker:complete \"Performance Test\"",
    "phase1:complete": "npm run tracker:phase \"Phase 1\" \"✅ COMPLETE\" 100 100 && echo 'Phase 1 completed successfully!'",
    "test:performance": "echo 'Running performance tests...' && npm test -- --testNamePattern=\"performance\" --verbose",
    "schema-map": "node scripts/tools/schema-map-cli.js",
    "schema:summary": "node scripts/tools/schema-map-cli.js summary",
    "schema:tables": "node scripts/tools/schema-map-cli.js tables",
    "schema:relationships": "node scripts/tools/schema-map-cli.js relationships",
    "schema:sparksplit": "node scripts/tools/schema-map-cli.js sparksplit",
    "schema:export": "node scripts/tools/schema-map-cli.js export",
    "schema:validate": "node scripts/tools/schema-map-cli.js validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@jest/globals": "^29.7.0",
    "@supabase/supabase-js": "^2.49.9",
    "airtable": "^0.12.2",
    "axios": "^1.9.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "inquirer": "^12.6.3",
    "micro": "^10.0.1",
    "next": "^14.1.0",
    "node-fetch": "^2.7.0",
    "node-mocks-http": "^1.17.2",
    "openai": "^4.98.0",
    "ora": "^8.2.0",
    "p-retry": "^6.2.1",
    "path": "^0.12.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "strip-json-comments": "^5.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.3",
    "vitest": "^3.1.4",
    "winston": "^3.17.0",
    "zod": "^3.25.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "CanAI Solutions",
  "license": "MIT"
}
