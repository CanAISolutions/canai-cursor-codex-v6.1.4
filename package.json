{
  "name": "canai-cursor",
  "version": "1.1.0",
  "description": "CanAI ORBITAL DREAM-STATE v1.1 Master Scaffold",
  "scripts": {
    "scaffold": "ts-node utils/scaffold-agent.ts",
    "test": "jest",
    "validate": "node scripts/validate.js",
    "simulate": "ts-node scripts/simulate-events.ts",
    "setup": "ts-node scripts/setup-project.ts",
    "docs": "ts-node scripts/generate-docs.ts",
    "build": "tsc",
    "start": "ts-node cursor/index.ts"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "fs": "0.0.1-security",
    "inquirer": "^8.0.0",
    "path": "^0.12.7",
    "uuid": "^11.1.0",
    "winston": "^3.8.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.98",
    "@types/winston": "^2.4.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/cursor/agents/**/*.test.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
