{
  "name": "cursor-debug-agent",
  "version": "4.1.3",
  "description": "Automated bug detection, fixing, and merging with AI and Git",
  "type": "module",
  "main": "cursor-debug-agent.ts",
  "scripts": {
  "start": "node run-debug.js",
  "build": "tsc",
  "test": "jest",
  "test:integration": "jest tests/integration.test.ts",
  "test:coverage": "jest --config=jest.config.mjs --coverage",
  "lint": "eslint . --ext .ts --ignore-path .gitignore",
  "lint:fix": "eslint . --ext .ts --fix",
  "audit": "npm audit",
  "validate": "ts-node scripts/validate.ts",
  "validate:metrics": "ts-node scripts/tools/validate-metrics.ts",
  "codex": "ts-node scripts/codex-check.ts",
  "validate:configs": "node scripts/validate-all-configs.js",
  "zip": "rm -f cursor-debug-agent.zip && zip -r cursor-debug-agent.zip cursor",
  "docker:build": "docker build -t cursor-debug-agent .",
  "docker:run": "docker run -v $(pwd)/error.log:/app/error.log -v $(pwd)/.canai-context:/app/.canai-context cursor-debug-agent",
  "test:prompt": "ts-node scripts/tools/runPromptTest.ts",
  "test:prompt:cases": "ts-node scripts/tools/generatePromptTestCases.ts",
  "test:prompt:delta": "ts-node scripts/tools/promptDeltaCompare.ts",
  "test:prompt:drift": "ts-node scripts/tools/scoreDriftWatcher.ts",
  "tune:prompt": "ts-node scripts/tools/tunePromptFromFeedback.ts",
  "promote:prompt": "ts-node scripts/tools/promotePromptVersion.ts",
  "audit:prompt": "ts-node scripts/tools/promptPerformanceAudit.ts",
  "docs:prompt": "ts-node scripts/tools/generatePromptDocs.ts",
  "convert:metrics": "ts-node scripts/tools/convert-metrics.ts",
  "schema:validate": "ts-node scripts/tools/fieldSchemaValidator.ts",
  "schema:usage": "ts-node scripts/tools/promptFieldUsageHeatmap.ts",
  "audit:retry": "ts-node scripts/tools/auditRetryUsage.ts",
  "test": "jest --config jest.config.ts",
  "test:logs": "jest tests/fix-log.test.ts",
  "cost:tokens": "ts-node scripts/tools/calculateGPTTokenCost.ts"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "node-fetch": "^3.3.2",
    "p-limit": "^5.0.0",
    "p-retry": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "jsonc-parser": "^3.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "zod": "^3.24.3"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.10.0"
}
