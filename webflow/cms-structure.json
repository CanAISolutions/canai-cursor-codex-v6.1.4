{
  "webflowSiteId": "656604b87d3f1c1d75e4c392",
  "version": "6.1.4",
  "lastUpdated": "2025-01-27",
  "collections": {
    "discovery-sessions": {
      "name": "Discovery Sessions",
      "slug": "discovery-sessions",
      "singularName": "Discovery Session",
      "fields": {
        "session-id": {
          "type": "PlainText",
          "required": true,
          "unique": true,
          "helpText": "Unique session identifier from orchestrator"
        },
        "user-intent": {
          "type": "RichText",
          "required": true,
          "helpText": "User's original intent description"
        },
        "selected-tone": {
          "type": "Option",
          "required": true,
          "options": ["playful", "bold", "calm", "luxury"],
          "helpText": "User's selected tone preference"
        },
        "industry": {
          "type": "Option",
          "required": false,
          "options": ["coffee", "bakery", "fitness", "consulting", "saas", "other"],
          "helpText": "User's industry selection"
        },
        "pain-point": {
          "type": "RichText",
          "required": false,
          "helpText": "User's described challenges"
        },
        "trust-score": {
          "type": "Number",
          "required": true,
          "helpText": "Final emotional trust score (0-5)"
        },
        "emotional-arc": {
          "type": "PlainText",
          "required": true,
          "helpText": "Type of emotional progression"
        },
        "spark-resonance": {
          "type": "Number",
          "required": true,
          "helpText": "Overall spark resonance score (0-1)"
        },
        "selected-spark-name": {
          "type": "PlainText",
          "required": false,
          "helpText": "Personalized spark concept name"
        },
        "make-scenario": {
          "type": "PlainText",
          "required": true,
          "helpText": "Triggered Make.com scenario type"
        },
        "processing-status": {
          "type": "Option",
          "required": true,
          "options": ["pending", "processing", "completed", "failed", "recovered"],
          "helpText": "Current processing status"
        },
        "created-at": {
          "type": "DateTime",
          "required": true,
          "helpText": "Session creation timestamp"
        },
        "completed-at": {
          "type": "DateTime",
          "required": false,
          "helpText": "Session completion timestamp"
        }
      }
    },
    "emotional-analytics": {
      "name": "Emotional Analytics",
      "slug": "emotional-analytics",
      "singularName": "Emotional Analytic",
      "fields": {
        "session-reference": {
          "type": "Reference",
          "required": true,
          "collection": "discovery-sessions",
          "helpText": "Reference to discovery session"
        },
        "emotional-fingerprint": {
          "type": "PlainText",
          "required": false,
          "helpText": "Language and emotional pattern fingerprint"
        },
        "trust-progression": {
          "type": "PlainText",
          "required": true,
          "helpText": "JSON array of trust score progression"
        },
        "emotional-triggers": {
          "type": "PlainText",
          "required": false,
          "helpText": "JSON array of detected emotional triggers"
        },
        "recovery-needed": {
          "type": "Switch",
          "required": true,
          "helpText": "Whether emotional recovery was triggered"
        },
        "recovery-success": {
          "type": "Switch",
          "required": false,
          "helpText": "Whether recovery was successful"
        },
        "dwell-time": {
          "type": "Number",
          "required": true,
          "helpText": "Time spent on form (seconds)"
        },
        "field-interactions": {
          "type": "Number",
          "required": true,
          "helpText": "Number of field interactions"
        },
        "user-agent": {
          "type": "PlainText",
          "required": false,
          "helpText": "Browser user agent string"
        },
        "referrer": {
          "type": "PlainText",
          "required": false,
          "helpText": "Page referrer URL"
        }
      }
    },
    "spark-concepts": {
      "name": "Spark Concepts",
      "slug": "spark-concepts",
      "singularName": "Spark Concept",
      "fields": {
        "concept-name": {
          "type": "PlainText",
          "required": true,
          "helpText": "Generated spark concept name"
        },
        "concept-description": {
          "type": "RichText",
          "required": true,
          "helpText": "Detailed concept description"
        },
        "resonance-score": {
          "type": "Number",
          "required": true,
          "helpText": "Concept resonance score (0-1)"
        },
        "emotional-hook": {
          "type": "PlainText",
          "required": true,
          "helpText": "Emotional engagement hook"
        },
        "target-tone": {
          "type": "Option",
          "required": true,
          "options": ["playful", "bold", "calm", "luxury"],
          "helpText": "Target tone for this concept"
        },
        "industry-alignment": {
          "type": "Option",
          "required": false,
          "options": ["coffee", "bakery", "fitness", "consulting", "saas", "universal"],
          "helpText": "Industry alignment"
        },
        "usage-count": {
          "type": "Number",
          "required": true,
          "helpText": "Number of times concept was selected"
        },
        "success-rate": {
          "type": "Number",
          "required": true,
          "helpText": "Success rate when used (0-1)"
        },
        "last-used": {
          "type": "DateTime",
          "required": false,
          "helpText": "Last time concept was used"
        },
        "active": {
          "type": "Switch",
          "required": true,
          "helpText": "Whether concept is active for selection"
        }
      }
    },
    "form-configurations": {
      "name": "Form Configurations",
      "slug": "form-configurations",
      "singularName": "Form Configuration",
      "fields": {
        "form-name": {
          "type": "PlainText",
          "required": true,
          "unique": true,
          "helpText": "Unique form identifier"
        },
        "webhook-endpoint": {
          "type": "PlainText",
          "required": true,
          "helpText": "Target webhook endpoint URL"
        },
        "fallback-endpoint": {
          "type": "PlainText",
          "required": false,
          "helpText": "Fallback endpoint for failures"
        },
        "validation-rules": {
          "type": "PlainText",
          "required": false,
          "helpText": "JSON validation rules configuration"
        },
        "analytics-config": {
          "type": "PlainText",
          "required": false,
          "helpText": "JSON analytics configuration"
        },
        "success-message": {
          "type": "RichText",
          "required": true,
          "helpText": "Success message to display"
        },
        "error-message": {
          "type": "RichText",
          "required": true,
          "helpText": "Error message to display"
        },
        "active": {
          "type": "Switch",
          "required": true,
          "helpText": "Whether form configuration is active"
        },
        "version": {
          "type": "PlainText",
          "required": true,
          "helpText": "Configuration version"
        },
        "last-updated": {
          "type": "DateTime",
          "required": true,
          "helpText": "Last update timestamp"
        }
      }
    }
  },
  "integrations": {
    "emotionalSovereigntyOrchestrator": {
      "endpoint": "/api/webhook/emotional-sovereignty-bridge",
      "method": "POST",
      "authentication": "bearer",
      "timeout": 30000,
      "retries": 3,
      "fallbackBehavior": "graceful"
    },
    "makeComScenarios": {
      "adminAddProject": {
        "webhookId": "1006807",
        "trustThreshold": 4.2,
        "description": "High trust project creation"
      },
      "addProject": {
        "webhookId": "1003214",
        "trustThreshold": 3.0,
        "description": "Standard project creation"
      },
      "emotionalRecovery": {
        "webhookId": "emotional-sovereignty",
        "trustThreshold": 0,
        "description": "Emotional recovery flow"
      }
    },
    "airtableIntegration": {
      "baseId": "{{AIRTABLE_BASE_ID}}",
      "connectionId": "{{AIRTABLE_CONNECTION_ID}}",
      "tables": {
        "EmotionalSovereignty": "Primary emotional processing data",
        "SparkSplitAnalytics": "A/B testing and comparison data",
        "SessionAnalytics": "User session and interaction data"
      }
    }
  },
  "fieldMappings": {
    "discoveryFunnelToOrchestrator": {
      "intent": "userInput.intent",
      "tone": "userInput.tone",
      "industry": "userInput.industry",
      "pain_point": "userInput.pain_point",
      "sessionId": "sessionId",
      "productType": "discovery_funnel",
      "preferredTone": "context.preferredTone",
      "dwellTime": "context.dwellTime",
      "fieldInteractions": "context.fieldInteractions",
      "timestamp": "context.timestamp"
    },
    "orchestratorToMakeWebhook": {
      "sessionId": "sessionId",
      "structuredIntent": "structuredIntent",
      "emotionalContext": "emotionalContext",
      "sparkResonance": "sparkResonance",
      "finalTrustScore": "emotionalArc.finalTrustScore",
      "emotionalArcType": "emotionalArc.emotionalArcType",
      "selectedSparkName": "sparkResonance.selectedSpark.personalizedName",
      "verificationStatus": "TRUTH-VERIFIED-INTEGRATION"
    }
  },
  "validationRules": {
    "intent": {
      "required": true,
      "minLength": 10,
      "maxLength": 1000,
      "pattern": "^[\\s\\S]*$"
    },
    "tone": {
      "required": true,
      "enum": ["playful", "bold", "calm", "luxury"]
    },
    "industry": {
      "required": false,
      "enum": ["coffee", "bakery", "fitness", "consulting", "saas", "other"]
    },
    "pain_point": {
      "required": false,
      "maxLength": 500
    },
    "sessionId": {
      "required": true,
      "pattern": "^[a-zA-Z0-9-_]+$"
    }
  },
  "analyticsEvents": {
    "funnelStarted": "User opened discovery funnel",
    "funnelClosed": "User closed discovery funnel",
    "intentCaptured": "User entered meaningful intent",
    "sparkRequested": "User submitted form",
    "sparkRequestedSuccess": "Form submission successful",
    "sparkRequestedError": "Form submission failed",
    "formValidationFailed": "Form validation errors"
  },
  "errorHandling": {
    "networkTimeout": {
      "message": "Request timed out. Please try again.",
      "action": "retry",
      "fallback": "static_form"
    },
    "serverError": {
      "message": "Server error. Please try again later.",
      "action": "fallback",
      "fallback": "email_collection"
    },
    "validationError": {
      "message": "Please check your input and try again.",
      "action": "highlight_fields",
      "fallback": "none"
    }
  },
  "performanceTargets": {
    "formLoadTime": "< 2 seconds",
    "submissionResponse": "< 5 seconds",
    "orchestratorProcessing": "< 30 seconds",
    "makeScenarioExecution": "< 45 seconds",
    "endToEndFlow": "< 60 seconds"
  }
}
