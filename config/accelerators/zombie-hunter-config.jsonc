{
  // Master switch for Zombie Hunter accelerator
  "enabled": true,

  // Max minutes of inactivity before rescue triggers
  "maxIdleMinutes": 5,

  // Rescue strategy: "prompt", "replay", or "feedback"
  "rescueStrategy": "replay",

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Toggle detailed metric emission
  "metricsEnabled": true,

  // Optional rescue-event logging settings
  "feedbackCapture": {
    // State key where session-check entries are written
    "stateKey": "zombie-hunter:session-check",
    // File to append structured rescue events
    "logFile": "/logs/feedback_log.json"
  }
}
