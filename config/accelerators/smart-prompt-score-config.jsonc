{
  // Master switch for Smart Prompt Score accelerator
  "enabled": true,

  // Path (relative) to your JSONC signal‐weight definitions
  "scoringWeightsPath": "./scoring-weights.jsonc",

  // Thresholds for score levels (key = level, value = minimum score)
  "thresholds": {
    "warn": 0.4,
    "good": 0.7,
    "great": 0.9
  },

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Toggle detailed metric emission
  "metricsEnabled": true,

  // Optional feedback capture settings
  "feedbackCapture": {
    // State key where final scores are written
    "stateKey": "smart-prompt-score:final-score",
    // File to append structured feedback events
    "logFile": "/logs/feedback_log.json"
  }
}
