{
  // Master switch for the Conversion Predictor Lite accelerator
  "enabled": true,

  // Minimum conversion score (0–1) required to proceed
  "scoreThreshold": 0.5,

  // Action to take when score is below threshold: "halt" to stop flow, "warn" to log and continue
  "fallbackAction": "warn",

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Toggle detailed metric emission for observability
  "metricsEnabled": true,

  // If present, shapes cost & feedback capture behavior
  "feedbackCapture": {
    // The acceleratorState key where feedback is written
    "stateKey": "conversion-predictor-lite:score-state",
    // File to which structured feedback events are appended
    "logFile": "/logs/feedback_log.json"
  }
}
