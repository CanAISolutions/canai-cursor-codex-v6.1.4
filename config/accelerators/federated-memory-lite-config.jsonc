{
  // Master switch for Federated Memory Lite accelerator
  "enabled": true,

  // Conflict resolution mode: "strict" rejects on conflict, "fallback" uses predefined fallback
  "routingMode": "fallback",

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Path (relative to the accelerator folder) to your conflict policy markdown
  "conflictPolicyPath": "./memory-conflict-policy.md",

  // Toggle detailed metric emission for routing decisions
  "metricsEnabled": true,

  // Optional feedback capture for unresolved conflicts
  "feedbackCapture": {
    // State key for storing conflict resolution records
    "stateKey": "federated-memory-lite:conflict-state",
    // File to which detailed conflict events are appended
    "logFile": "/logs/feedback_log.json"
  }
}
