{
  // Master switch for Tone Override Agent
  "enabled": true,

  // Similarity score (0–1) below which override is triggered
  "toneThreshold": 0.75,

  // Fallback tone to apply when override fires
  "fallbackTone": "professional",

  // If true, override is applied automatically; if false, only flagged
  "allowOverride": true,

  // Path (relative) to your tone‐profile definitions JSONC
  "toneProfilePath": "./tone-profiles.jsonc",

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Toggle detailed metric emission
  "metricsEnabled": true,

  // Optional feedback-capture settings
  "feedbackCapture": {
    // State key where tone-results are written
    "stateKey": "tone-override:result",
    // File to append structured override events
    "logFile": "/logs/feedback_log.json"
  }
}
