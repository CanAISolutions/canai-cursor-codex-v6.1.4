{
  // Master switch for the Auto-Rollback accelerator
  "enabled": true,

  // “soft”: only log and notify; “hard”: immediately invoke promptReplay()
  "fallbackMode": "hard",

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Relative path (from the accelerator folder) to your policy doc
  "policyPath": "./rollback-policy.md",

  // Relative path to your JSONC trigger definitions
  "triggerConditionsPath": "./trigger-conditions.jsonc",

  // Toggle detailed metric emission for observability
  "metricsEnabled": true,

  // If present, shapes cost & feedback data to this object
  "feedbackCapture": {
    // Write to this log key in acceleratorState
    "stateKey": "auto-rollback:trigger-state",
    // Also append to this feedback logfile
    "logFile": "/logs/feedback_log.json"
  }
}
