{
  // Master switch for Swarm Agents accelerator
  "enabled": true,

  // List of sub-agent IDs to coordinate (e.g., ["tone", "rewrite"])
  "agentTypes": ["tone-checker", "rewrite-suggester"],

  // Path (relative to accelerator folder) to the decision policy markdown
  "decisionPolicyPath": "./swarm-decision-policy.md",

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Override for agreement threshold (0–1); defaults to 0.6 if omitted
  "consensusThreshold": 0.6,

  // Toggle detailed metric emission
  "metricsEnabled": true,

  // Optional capture of voting trace events
  "feedbackCapture": {
    // State key where vote‐state entries are written
    "stateKey": "swarm-agents:vote-state",
    // File to append structured voting events
    "logFile": "/logs/feedback_log.json"
  }
}
