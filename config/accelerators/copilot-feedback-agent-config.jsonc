{
  // Master switch for the Copilot Feedback Agent
  "enabled": true,

  // Tags to watch for in input/output to flag feedback triggers
  "interventionTags": ["error", "confusion", "clarification"],

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Path (relative to the accelerator folder) to feedback rules JSONC
  "feedbackRulesPath": "./copilot-feedback-rules.jsonc",

  // Path (relative to the accelerator folder) to the fallback policy MD file
  "policyPath": "./copilot-feedback-policy.md"
}
