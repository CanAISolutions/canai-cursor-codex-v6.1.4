{
  // Master switch for Prompt Genetics accelerator
  "enabled": true,

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Whether to track genetic lineage of prompt traits
  "lineageTracking": true,

  // Toggle detailed metric emission for trait extraction
  "metricsEnabled": true,

  // Optional capture of genome events for feedback or analytics
  "feedbackCapture": {
    // State key for storing genome-state entries
    "stateKey": "prompt-genetics:genome-state",
    // File to which structured events are appended
    "logFile": "/logs/feedback_log.json"
  }
}
