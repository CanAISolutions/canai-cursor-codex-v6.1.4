{
  // Master switch for Reverse Synthesis Core accelerator
  "enabled": true,

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Path (relative) to your JSONC pattern definitions
  "synthesisPatternsPath": "./synthesis-patterns.jsonc",

  // Enable verbose trace-dump logging
  "traceLogging": false,

  // Toggle detailed metric emission
  "metricsEnabled": true,

  // Optional feedback capture for pattern‐matching outcomes
  "feedbackCapture": {
    // State key for writing trace-state entries
    "stateKey": "reverse-synthesis-core:trace-state",
    // File to append structured feedback events
    "logFile": "/logs/feedback_log.json"
  }
}
