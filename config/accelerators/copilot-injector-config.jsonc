{
  // Master switch for Copilot Injector
  "enabled": true,

  // Tags that trigger injection (e.g. 'clarity', 'optimize')
  "triggerTags": ["clarity", "optimize"],

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Path (relative to accelerator folder) to injection policy markdown
  "feedbackPolicyPath": "./copilot-feedback-policy.md",

  // Confidence threshold (0–1) above which suggestions fire
  "injectThreshold": 0.75
}
