// File: /config/accelerators/emotional-foresight-lite-config.jsonc
{
  // Master switch for Emotional Foresight Lite
  "enabled": true,

  // Which model variant to run (e.g., "v1", "v2-alpha")
  "modelVariant": "v1",

  // Sensitivity for drift detection (0–1 scale)
  "triggerThreshold": 0.7,

  // Winston log level: error, warn, info, debug
  "logLevel": "info",

  // Path (relative) to the emotional fallback policy markdown
  "interventionPolicyPath": "./intervention-policy.md",

  // Toggle detailed metric emission
  "metricsEnabled": true,

  // Optional feedback capture settings
  "feedbackCapture": {
    // State key where drift events are recorded
    "stateKey": "emotional-foresight-lite:signal-state",
    // File to append structured feedback entries
    "logFile": "/logs/feedback_log.json"
  }
}
