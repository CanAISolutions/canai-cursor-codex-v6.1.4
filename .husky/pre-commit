#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🛡️ Running DreamState Protection Guard..."
npm run dreamstate:protect

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: DreamState protection failed!"
  echo "🚨 Fix violations before committing"
  echo "📄 Check dreamstate-protection-report.md for details"
  exit 1
fi

echo "✅ DreamState protection passed - commit allowed" 