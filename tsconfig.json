{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "allowJs": false
  },
  "include": ["src", "tests", "cursor", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
