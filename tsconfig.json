{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"],
      "cursor/agents/debug/engines": ["cursor/agents/debug/engines/index.ts"],
      "cursor/agents/debug/engines/ai-provider": ["cursor/agents/debug/engines/ai-provider.ts"],
      "cursor/agents/debug/config/*": ["cursor/agents/debug/config/*"],
      "config/*": ["config/*"]
    }
  },
  "include": [
    "cursor/**/*.ts",
    "api/**/*.ts",
    "lib/**/*.ts",
    "prompts/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "scripts/**/*.ts",
    "utils/**/*.ts",
    "analytics/**/*.ts",
    "agents/debug/src/**/*.ts",
    "agents/debug/utils/**/*.ts",
    "agents/debug/tests/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "test-reports",
    "test-data",
    "logs",
    "**/__snapshots__/",
    "**/snapshots/",
    "**/*.d.ts",
    "**/*.test-report.*",
    "**/*.generated.*",
    "**/*.min.*",
    "**/*.zip"
  ]
}