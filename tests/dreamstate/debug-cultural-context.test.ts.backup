import { CulturalContextEngine } from '../../src/global-sovereignty/cultural-context-engine';

describe('Debug CulturalContextEngine', () => {
  test('should have the required methods', () => {
    const engine = new CulturalContextEngine();
    
    console.log('CulturalContextEngine instance:', engine);
    console.log('constructor.name:', engine.constructor.name);
    console.log('Instance methods:', Object.getOwnPropertyNames(Object.getPrototypeOf(engine)));
    console.log('calibrateEmotionalIntensity type:', typeof engine.calibrateEmotionalIntensity);
    console.log('calibrateEmotionForCulture type:', typeof engine.calibrateEmotionForCulture);
    console.log('adaptForCulture type:', typeof engine.adaptForCulture);
    
    // Check if methods exist
    expect(engine.calibrateEmotionalIntensity).toBeDefined();
    expect(typeof engine.calibrateEmotionalIntensity).toBe('function');
    expect(engine.calibrateEmotionForCulture).toBeDefined();
    expect(typeof engine.calibrateEmotionForCulture).toBe('function');
  });
}); 