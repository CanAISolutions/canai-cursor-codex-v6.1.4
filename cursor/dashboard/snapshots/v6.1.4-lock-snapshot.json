{
  "version": "v6.1.4",
  "lockDate": "2024-03-21",
  "trustScoreThreshold": 4.2,
  "status": "LOCKED",
  "components": {
    "healthScore": {
      "weights": {
        "delta": 0.4,
        "coverage": 0.3,
        "persona": 0.3
      },
      "thresholds": {
        "critical": 0.7,
        "warning": 0.8
      }
    },
    "alerting": {
      "channels": ["slack", "notion"],
      "severityLevels": ["critical", "warning"],
      "priorityLevels": ["high", "medium", "low"]
    },
    "monitoring": {
      "metrics": [
        "healthScore",
        "deltaScore",
        "coverageScore",
        "personaScore",
        "usageMetrics"
      ],
      "visualization": {
        "trendSparkline": true,
        "unicodeIndicators": true
      }
    },
    "integration": {
      "slack": {
        "channels": ["#founder-digest", "#founder-alerts"],
        "enabled": true
      },
      "notion": {
        "databases": ["prompt-health", "alerts"],
        "enabled": true
      }
    }
  },
  "requirements": {
    "structuralValidation": true,
    "personaFidelity": true,
    "regressionProtection": true,
    "ciIntegration": true,
    "usageIntelligence": true,
    "visibilityLayer": true
  },
  "maintenance": {
    "weekly": ["healthScoreReview"],
    "monthly": ["trendAnalysis"],
    "quarterly": ["thresholdAdjustment"],
    "continuous": ["monitoring", "archiving"]
  }
} 