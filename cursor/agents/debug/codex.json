{
    "name": "cursor-debug-agent",
    "version": "4.1.3",
    "description": "AI-powered debugging agent for automated fix generation and GitHub PR creation",
    "entry": "./cursor-debug-agent.ts",
    "main": "./cursor-debug-agent.ts",
    "scripts": {
      "start": "ts-node run-debug.ts",
      "build": "tsc",
      "test": "jest"
    },
    "dependencies": {
      "node": ">=16.0.0",
      "typescript": ">=5.0.0",
      "git": ">=2.30.0"
    },
    "devDependencies": {
      "jest": "^29.7.0",
      "ts-jest": "^29.2.5",
      "@types/jest": "^29.5.12"
    },
    "codex": {
      "type": "debug-agent",
      "environment": "node",
      "configFile": ".cursorrules",
      "outputFiles": [".canai-context/fix.log", ".canai-context/metrics.json"],
      "trusted": true,
      "requires": ["ai", "git", "openai", "github"]
    }
  }
  