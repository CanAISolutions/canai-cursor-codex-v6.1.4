{
    // Signal patterns that define a "zombie session"
    "thresholds": {
      "maxRevisionCount": 5,
      "minEmotionScore": 0.2,
      "minOutputDelta": 0.05
    },
    "patterns": [
      {
        "name": "no-change-loop",
        "conditions": ["same-output-3x", "revise-count >= 3"]
      },
      {
        "name": "emotion-flatline",
        "conditions": ["emotionScore < 0.2", "no change after 2 revisions"]
      },
      {
        "name": "drift-deadzone",
        "conditions": ["outputDelta < 0.05", "tone = flat"]
      }
    ]
  }
  