{
    /**
     * @file /cursor/accelerators/tone-override-agent/tone-profiles.jsonc
     * @purpose Declarative schema of tone override presets for emotional correction or drift repair
     * @invokedBy tone-overrider.ts, Copilot feedback agents, promptReplay recovery
     * @outputs Tone profile: traits object for override injection into prompt scaffolding
     * @integration Matches smart-prompt-score trait schema; synced with prompt-genetics variants
     * @codex Prevents emotional decay, tone misfire, and flat default outputs — restores UX resonance
     */
  
    "tones": [
      {
        "id": "reassuring-clarity",
        "traits": {
          "tone-clarity": 0.9,
          "emotional-resonance": "aligned",
          "revision-count": 0
        },
        "description": "Warm, clear, and supportive — used when emotionScore is low but user seems uncertain"
      },
      {
        "id": "confident-direct",
        "traits": {
          "tone-clarity": 1.0,
          "emotional-resonance": "aligned",
          "revision-count": 1
        },
        "description": "Sharp, high-authority tone — ideal for users looking for decisive messaging"
      },
      {
        "id": "light-encouragement",
        "traits": {
          "tone-clarity": 0.8,
          "emotional-resonance": "inspiring",
          "revision-count": 0
        },
        "description": "Gentle uplift used when tone is flat but drift is minimal"
      }
    ],
    "defaults": {
      "minEmotionScoreForOverride": 0.3,
      "forceOverrideIfDriftAbove": 0.8
    }
  }
  