{
    /**
     * @file /cursor/accelerators/copilot-feedback-agent/copilot-feedback-rules.jsonc
     * @purpose Defines when and how Copilot can provide emotional feedback or intervention
     * @invokedBy CopilotFeedbackAgent, zombie-hunter, reviseLoop, replay flows
     * @outputs Feedback injection object (message, type, context)
     * @integration Ingests emotionScore, toneClarity, revisionCount, overrideTriggers
     * @codex Protects UX dignity while allowing helpful course correction at critical moments
     */
  
    "triggers": [
      {
        "name": "emotion-flatline",
        "if": { "emotionScoreBelow": 0.25, "revisionCountAtLeast": 2 },
        "copilotSay": "Want to try a warmer tone or a new angle?"
      },
      {
        "name": "revision-fatigue",
        "if": { "revisionCountAbove": 4, "outputDeltaBelow": 0.1 },
        "copilotSay": "Looks like we’re circling. Want a fresh restart or ask differently?"
      },
      {
        "name": "tone-mismatch-drift",
        "if": { "toneClarityBelow": 0.6, "outputDriftAbove": 0.8 },
        "copilotSay": "I think we veered off tone. Try one that matches your vibe?"
      }
    ],
    "defaults": {
      "maxSuggestionsPerSession": 2,
      "allowOverrideIfZombieDetected": true
    }
  }
  