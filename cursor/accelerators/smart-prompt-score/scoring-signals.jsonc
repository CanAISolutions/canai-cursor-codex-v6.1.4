{
    // Defines prompt quality scoring signals for pre/post evaluation
    "signals": [
      {
        "name": "clarityScore",
        "type": "numerical",
        "range": [0.0, 1.0],
        "weight": 0.3,
        "goal": "maximize"
      },
      {
        "name": "emotionScore",
        "type": "numerical",
        "range": [0.0, 1.0],
        "weight": 0.3,
        "goal": "maximize"
      },
      {
        "name": "outputDelta",
        "type": "numerical",
        "range": [0.0, 1.0],
        "weight": 0.15,
        "goal": "maximize"
      },
      {
        "name": "revisionCount",
        "type": "integer",
        "range": [0, 10],
        "weight": 0.1,
        "goal": "minimize"
      },
      {
        "name": "reuseRate",
        "type": "percentage",
        "range": [0.0, 1.0],
        "weight": 0.15,
        "goal": "maximize"
      }
    ],
    "scoring": {
      "maxScore": 100,
      "minScore": 0,
      "scoreGranularity": 0.1,
      "passThreshold": 72,
      "goldThreshold": 90,
      "fallbackThreshold": 50
    }
  }
  