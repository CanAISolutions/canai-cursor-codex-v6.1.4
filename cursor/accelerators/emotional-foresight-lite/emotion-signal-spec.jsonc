{
    // 🔍 Emotional Signal Detection Blueprint — CanAI Foresight-Lite
    // Used by foresight-model-lite.ts to trigger interventions based on emotional behavior patterns
  
    "meta": {
      "schemaVersion": "1.0.0",
      "lastUpdated": "2025-04-30",
      "defaultSignal": "none-detected" // Used when no signals match
    },
  
    "signals": [
      {
        "name": "escalating-frustration",
        "description": "User is revising repeatedly with signs of confusion and output drift",
        "detectors": [
          "revise-count > 2",
          "tone = confused",
          "deltaScore > 0.3"
        ],
        "severity": "high",
        "signalConfidence": 0.9
      },
      {
        "name": "loop-fatigue",
        "description": "User appears stuck in input loop, possibly overwhelmed or lost",
        "detectors": [
          "same-input-used-3x",
          "session-duration > 5m"
        ],
        "severity": "medium",
        "signalConfidence": 0.7
      },
      {
        "name": "hope-signal",
        "description": "User is showing signs of optimism or clarity breakthrough",
        "detectors": [
          "emotion = inspired",
          "output-clarity-score > 0.8"
        ],
        "severity": "low-positive",
        "signalConfidence": 0.85
      },
      {
        "name": "quiet-drift",
        "description": "Session is quiet but emotional score is declining — potential disengagement",
        "detectors": [
          "revision-count = 0",
          "emotionScore decline over 2 steps"
        ],
        "severity": "silent-danger",
        "signalConfidence": 0.8
      }
    ],
  
    "thresholds": {
      "deltaScore": 0.25,
      "reviseCount": 2,
      "emotionScoreDrop": 0.15
    }
  }
  