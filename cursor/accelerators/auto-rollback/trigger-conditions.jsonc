{
  // Trigger conditions for rollback initiation

  // 🔁 Rollback if output delta score exceeds this threshold
  "deltaScoreThreshold": 0.25, // >25% divergence in output-delta

  // 🧠 Emotional derailment flag (from emotionalDriftPredictor.ts)
  "emotionalDrift": true,

  // ⚙️ System modularity failure detected (e.g., failed compartmental recovery)
  "modularityBreak": true,

  // 🔍 Self-check system component failures (indicates potential decay)
  "selfCheckFailure": [
    "cursorHeartbeat",          // Top-level health signal
    "promptFixSuggestor",       // Suggestor engine failed to recover prompt
    "sessionDeltaLogEmitter"    // Logging system not emitting rollback events
  ],

  // 🚨 Manual override from UX or system agents (bypasses validation)
  "manualOverride": true
}
