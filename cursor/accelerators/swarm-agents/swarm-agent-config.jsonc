{
    // 📘 Swarm Agent Configuration – Snapshot v1.0.0
    // Defines all available swarm agents, roles, default execution mode, and schema metadata.
  
    "version": "1.0.0",
    "schemaType": "SwarmAgentConfig",
  
    "swarmModes": [
      "parallel-vote",         // All agents run in parallel, last valid output wins
      "sequential-refine",     // Each agent hands off its output to the next
      "fallback-cascade"       // Stop after first successful agent result
    ],
  
    "defaultMode": "parallel-vote",
  
    "agents": [
      {
        "id": "storyteller",
        "role": "generate emotional variant",
        "agentFile": "agents/storyteller.agent.md",     // normalized path
        "copilotSignature": "agent.emotion-crafter",    // optional
        "priorityWeight": 0.6
      },
      {
        "id": "recursive-thinker",
        "role": "deepen or extend reasoning path",
        "agentFile": "agents/recursive-thinker.ts",
        "copilotSignature": "agent.depth-expander",
        "priorityWeight": 1.0
      },
      {
        "id": "output-evaluator",
        "role": "score + select strongest variant",
        "agentFile": "agents/output-evaluator.ts",
        "copilotSignature": "agent.result-selector",
        "priorityWeight": 0.9
      }
    ]
  }
  