{"triggers":[{"id":"low-score-feedback","conditions":["score < 72","clarityScore < 0.5 || emotionScore < 0.4"],"copilotMessage":"Looks like this output may not feel quite right. Want a tone fix or clarity boost?"},{"id":"zombie-stallout","conditions":["revisionCount > 4","outputDelta < 0.05"],"copilotMessage":"This session might be stuck. Want to try a new direction or fresh prompt?"},{"id":"emotion-flatline","conditions":["emotionScore < 0.2"],"copilotMessage":"Want to try a more emotionally aligned rewrite?"},{"id":"revise-loop-fatigue","conditions":["revisionCount > 6","outputDelta < 0.1"],"copilotMessage":"Looks like we're looping. Want to try a new approach?"}],"defaults":{"maxSuggestionsPerSession":2,"allowOverrideIfZombieDetected":true}}
  