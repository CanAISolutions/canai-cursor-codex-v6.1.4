{
    // memory-routing-spec.jsonc
    // 🧠 Federated Memory Routing Schema – Codex Compatible & LLM Upgradable
  
    "version": "1.0.0",
    "schemaType": "FederatedMemoryRouting",
  
    // Tier definitions represent order of memory source resolution
    "tiers": [
      "local-session",         // most volatile, session-scoped context
      "persona-shard",         // stable user traits and tone
      "global-memory",         // general knowledge / shared state
      "system-override"        // forced overrides for system-level agents
    ],
  
    // Routing rules define how to resolve intent-specific memory
    "routingRules": [
      {
        "intent": "user-personalization",
        "priority": ["local-session", "persona-shard"]
      },
      {
        "intent": "agent-alignment",
        "priority": ["persona-shard", "global-memory"]
      },
      {
        "intent": "system-checkpoint",
        "priority": ["system-override", "global-memory"]
      }
    ],
  
    // Fallback rules for edge cases or conflict resolution
    "fallback": {
      "on-collision": "last-write-wins",                     // if multiple tiers provide values
      "on-missing": "revert to persona-shard",               // if no tier has value
      "on-version-mismatch": "use global-memory if timestamp > session"
    }
  }
  