{
    // 🧠 Synthesis Pattern Map – v1.0.0
    // Used by reverse-synthesis-engine.ts to infer prompt intent, tone, and seed structure from output text.
  
    "version": "1.0.0",
    "schemaType": "ReverseSynthesisPatternMap",
  
    "patterns": [
      {
        "name": "vision-statement",
        "match": "the future of|our vision is|we believe that",
        "intent": "business_vision",
        "tone": "inspiring",
        "template": "vision-declaration",
        "tags": ["clarity", "future", "belief"]
      },
      {
        "name": "value-prop-sequence",
        "match": "introducing|built for|designed to|delivers .*?, .*?, and .*?",
        "intent": "value_proposition",
        "tone": "strategic",
        "template": "product-launch",
        "tags": ["clarity", "benefits", "pitch"]
      },
      {
        "name": "call-to-action",
        "match": "get started|schedule your|start now|join us today",
        "intent": "conversion_cta",
        "tone": "motivational",
        "template": "cta-email",
        "tags": ["action", "urgency"]
      },
      {
        "name": "tone-emotional-alignment",
        "match": "feel confident|build trust|emotional clarity|you’re not alone",
        "intent": "emotional_resonance",
        "tone": "empathetic",
        "template": "supportive-copy",
        "tags": ["emotion", "connection"]
      },
      {
        "name": "feature-breakdown",
        "match": "includes|features|comes with|supports .*?, .*?, and .*?",
        "intent": "product_features",
        "tone": "informative",
        "template": "feature-listing",
        "tags": ["clarity", "benefit"]
      },
      {
        "name": "expert-positioning",
        "match": "trusted by|backed by|our team of experts|industry-leading",
        "intent": "credibility_boost",
        "tone": "authoritative",
        "template": "proof-section",
        "tags": ["trust", "authority", "proof"]
      }
    ]
  }
  