{
    // 📘 Prompt Trait Schema – Codex Snapshot v1.0.0
    // This schema defines traits used in prompt genome evolution.
    // Each trait includes its type, expected range or values, and fitness goal.
  
    "version": "1.0.0",
    "schemaType": "PromptTraitSchema",
  
    "traits": [
      {
        "name": "tone-clarity",                   // How clear the tone is perceived
        "type": "numerical",                      // Value between 0.0 and 1.0
        "range": [0.0, 1.0],
        "goal": "maximize"
      },
      {
        "name": "emotional-resonance",            // Subjective tone strength
        "type": "categorical",                    // Categorical trait to evolve tone preference
        "values": ["flat", "neutral", "aligned", "inspiring"],
        "goal": "maximize"
      },
      {
        "name": "reuse-rate",                     // Percentage of user prompt reuse
        "type": "numerical",                      // Treated as percentage (0.0 - 1.0)
        "range": [0.0, 1.0],
        "goal": "maximize"
      },
      {
        "name": "revision-count",                 // Number of prompt revisions by the user
        "type": "integer",                        // Lower is better
        "range": [0, 10],
        "goal": "minimize"
      }
    ]
  }
  