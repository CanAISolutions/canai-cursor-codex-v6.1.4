{
    // @codex-purpose: Centralized Dream-State system emotional UX and operational resilience constants.
    // @codex-system: Dream-State Global Configuration
    // @codex-critical: Prevents silent UX decay, scaling drift, and emotional trust erosion across platform expansion.
    // @codex-verified: v1.0.0
  
    "payload": {
      "maxResponseBodyKb": 256, // Maximum size (in KB) allowed for a successful API response body
      "maxRequestBodyKb": 128,  // Maximum size (in KB) allowed for incoming request body before emotional error triggers
      "maxMetaFields": 10       // Maximum meta fields allowed inside error or rate-limit payloads
    },
    
    "rateLimit": {
      "defaultRetryAfterSeconds": 60, // Default retry-after window shown to users under overload
      "earlyScalingLimit": 100,        // Default max requests per window for early-stage scaling
      "earlyScalingWindowMs": 60000    // 1 minute window
    },
    
    "errors": {
      "defaultErrorCode": "INTERNAL_SERVER_ERROR",
      "defaultErrorMessage": "Something went wrong. Please try again later.",
      "invalidInputCode": "INVALID_INPUT",
      "invalidInputMessage": "One or more fields are invalid. Please check your input and try again.",
      "rateLimitExceededCode": "RATE_LIMIT_EXCEEDED",
      "rateLimitExceededMessage": "You're sending requests too quickly. Please slow down and try again."
    },
    
    "emotionalUx": {
      "validationTone": "supportive",     // Supportive, not punitive language in validation failures
      "rateLimitTone": "empathetic",      // Empathetic, not aggressive rate-limit messaging
      "errorTone": "reassuring"            // Reassuring default tone even for serious failures
    }
  }
  