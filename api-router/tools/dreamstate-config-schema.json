{
    "$schemaVersion": "v1.0.0",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Dream-State Global Configuration Schema",
    "description": "Defines the safe, emotionally intelligent structure for Dream-State system operational constants.",
    "type": "object",
    "required": ["payload", "rateLimit", "errors", "emotionalUx"],
    "properties": {
      "payload": {
        "type": "object",
        "required": ["maxResponseBodyKb", "maxRequestBodyKb", "maxMetaFields"],
        "properties": {
          "maxResponseBodyKb": { "type": "integer", "minimum": 1 },
          "maxRequestBodyKb": { "type": "integer", "minimum": 1 },
          "maxMetaFields": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "rateLimit": {
        "type": "object",
        "required": ["defaultRetryAfterSeconds", "earlyScalingLimit", "earlyScalingWindowMs"],
        "properties": {
          "defaultRetryAfterSeconds": { "type": "integer", "minimum": 1 },
          "earlyScalingLimit": { "type": "integer", "minimum": 1 },
          "earlyScalingWindowMs": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "errors": {
        "type": "object",
        "required": [
          "defaultErrorCode",
          "defaultErrorMessage",
          "invalidInputCode",
          "invalidInputMessage",
          "rateLimitExceededCode",
          "rateLimitExceededMessage"
        ],
        "properties": {
          "defaultErrorCode": { "type": "string", "minLength": 1 },
          "defaultErrorMessage": { "type": "string", "minLength": 1 },
          "invalidInputCode": { "type": "string", "minLength": 1 },
          "invalidInputMessage": { "type": "string", "minLength": 1 },
          "rateLimitExceededCode": { "type": "string", "minLength": 1 },
          "rateLimitExceededMessage": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "emotionalUx": {
        "type": "object",
        "required": ["validationTone", "rateLimitTone", "errorTone"],
        "properties": {
          "validationTone": { "type": "string", "enum": ["supportive", "neutral", "empathic"] },
          "rateLimitTone": { "type": "string", "enum": ["empathetic", "supportive", "neutral"] },
          "errorTone": { "type": "string", "enum": ["reassuring", "neutral", "uplifting"] }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
  