# Node dependencies and build artifacts
node_modules/
dist/
build/
out/
*.tsbuildinfo
*.tmp

# Performance optimization: Exclude large binary files and assets
**/*.node
**/*.dll
**/*.wasm
**/*.js.map
**/*.css.map
**/*.ts.map

# Performance optimization: Exclude large JSON assets
**/capsize-font-metrics.json
**/font-metrics.json

# Performance optimization: Exclude Jest cache
.jest-cache/

# Performance optimization: Large log files and backups
**/*.backup.*
**/*.archive.*
**/archived-*.md
**/*-backup-*.md
cursor/logs/**/*.log
cursor/system-intel/**/*.log.md
cursor/debug/**/*.log
**/*.log.md
!cursor/auto-actions.log.md

# Performance optimization: Excel and large data files
**/*.xlsx
**/*.xls
**/*.csv

# Local env + runtime (but allow .env.local for development)
.env
.env.production
.env.staging
.DS_Store

# Test output + logs (but NOT test code)
test-reports/
*.snap
coverage/
*.test-report.md
*.test-report.json
test-data/
test-data/snapshots/
**/__snapshots__/
**/snapshots/
*.coverage

# Ignore compiled or AI-generated assets
*.generated.*
*.min.*
*.zip

# Cursor temp / cache files
.cursor-cache/

# Editor and system files
.vscode/
Thumbs.db

# Runtime/debug/metrics output
.canai-context/*.log
.canai-context/*.json
.canai-context/*.jsonl
logs/

# Explicit inclusions for Codex integrity (if needed)
!/cursor/self-awareness.json
!/cursor/cursor-ingest.md
!/docs/system-map.md
!/tests/ci/ingest-drift-check.test.ts

# Do NOT exclude test code or diagnostics
# (e.g., do NOT add: tests/, __tests__/, *.test.ts, *.spec.ts)
