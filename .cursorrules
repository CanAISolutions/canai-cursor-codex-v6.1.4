{
  "ingestion-lock": [
    {
      "path": "docs/codex-handover.md",
      "canonical": true
    },
    {
      "path": "docs/archive/**",
      "deny": true
    }
  ],
  "agentConfig": {
    "defaultAgent": "Claude-4-Sonnet",
    "productAgent": "GPT-4o",
    "fallbackAgent": "GPT-4o",
    "fallbackConditions": [
      "token window exceeds 200k",
      "real-time latency under 1.5s required",
      "Claude API outage or system breach"
    ],
    "codingAgent": "Claude-4-Sonnet",
    "testAgent": "Claude-4-Sonnet",
    "systemAgent": "Claude-4-Sonnet",
    "emotionalClarityBias": "High",
    "fallbackDriftTolerance": "Low",
    "multilingualTrustSensitivity": "High",
    "mocksPermitted": false,
    "enforceMockZero": true,
    "overrideRequires": "Cofounder + Codex Approval",
    "performanceOptimization": {
      "enabled": true,
      "cacheStrategy": "aggressive",
      "parallelProcessing": true,
      "lazyLoading": true
    },
    "testFirstTruth": {
      "enabled": true,
      "principle": "Never assume completion without test validation",
      "enforcement": "mandatory",
      "exceptions": "none"
    }
  },
  "trustScoreThreshold": 4.2,
  "testFirstTruth": {
    "principle": "Test-First Truth: Nothing is complete until tests prove it works",
    "enforcement": {
      "mandatory": true,
      "noExceptions": true,
      "blockDeployment": true,
      "requireTestEvidence": true
    },
    "standards": {
      "everyFeature": "Must have passing test before claiming completion",
      "everyAPI": "Must have integration test validating actual communication",
      "everyComponent": "Must have unit test proving functionality",
      "everyIntegration": "Must have end-to-end test confirming real-world operation",
      "everyDeployment": "Must have health check test confirming live operation"
    },
    "validation": {
      "testRequired": true,
      "evidenceRequired": true,
      "documentationRequired": true,
      "auditTrailRequired": true
    },
    "consequences": {
      "noTestNoCompletion": true,
      "noTestNoDeployment": true,
      "noTestNoDocumentation": true,
      "noTestNoSignoff": true
    }
  },
  "aiProvider": "openai",
  "aiProviderConfig": {
    "apiKey": "",
    "model": "gpt-4o"
  },
  "claudeConfig": {
    "model": "claude-4-sonnet",
    "maxTokens": 200000,
    "temperature": 0.7,
    "systemRole": "coding, testing, schema validation, emotional intelligence"
  },
  "githubConfig": {
    "token": "",
    "owner": "CanAISolutions",
    "repo": "canai-cursor-codex-v6.1.4",
    "baseBranch": "preboot",
    "reviewTag": "codex-reviewed"
  },
  "eslintConfig": {
    "enabled": true,
    "configFile": "eslint.config.js",
    "maxErrors": 5,
    "errorPenalty": 0.5
  },
  "performance": {
    "indexingOptimization": {
      "enabled": true,
      "excludeLargeFiles": true,
      "prioritizeActiveFiles": true,
      "cacheFrequentlyUsed": true
    },
    "velocityAcceleration": {
      "enabled": true,
      "launchCriticalPriority": true,
      "blockerEliminationSpeed": "immediate",
      "decisionSpeed": "<2hours"
    },
    "quantumOptimization": {
      "enabled": true,
      "predictiveAccuracy": 0.95,
      "adaptationSpeed": "<100ms",
      "realTimeOptimization": true
    },
    "sparkSplitOptimization": {
      "enabled": true,
      "trustEngineAcceleration": true,
      "emotionalSovereigntySupport": true,
      "revolutionaryTrustTransparency": true,
      "competitiveAdvantagePreservation": true
    }
  },
  "rules": {
    "promptFormat": "markdown-commented",
    "fileNaming": "kebab-case",
    "tone": "codex-aligned, emotionally intelligent, operator voice",
    "commenting": "every function, every logic block, and every public constant",
    "reasoningCommentStyle": "what/why/how",
    "linting": true,
    "testFirstTruth": {
      "enforceTestValidation": true,
      "requireTestEvidence": true,
      "blockUntestedClaims": true,
      "mandatoryTestDocumentation": true
    },
    "branding": {
      "version": "v1.2",
      "codexLock": "CanAI-Brand-Core/v1.2",
      "primaryColor": "#00CFFF",
      "accentColor": "#00F0FF",
      "backgroundDark": "#0A0F1C",
      "lightText": "#E6F6FF",
      "gradientAnchor": "#00B2E3",
      "font": "Manrope",
      "fallbackFonts": "Inter, Helvetica Neue, sans-serif",
      "tagline": "Empowerment Through Ease",
      "domain": "CanAI.so",
      "logo": "canai-logo.svg",
      "visualTheme": "Futuristic, emotionally resonant, ease-centric",
      "corePromise": "Emotionally intelligent, zero-manual-touch strategy engine for small businesses",
      "cubeMotif": {
        "required": true,
        "always3D": true,
        "centralAnchor": true,
        "glowEffect": true
      },
      "iconography": {
        "style": "line-based, glowing neon vector",
        "strokeWidth": "1.5-2px",
        "glowRequired": true,
        "orbitEffect": true
      },
      "consistency": {
        "taglineRequired": true,
        "domainGradient": true,
        "noFlatCube": true,
        "glowEffectsRequired": true
      }
    },
    "enforcement": {
      "rejectEmptyFiles": true,
      "requirePromptExamples": true,
      "requirePromptVersioning": true,
      "requireTestForExports": true,
      "blockConsoleLogs": true,
      "blockUnhandledRejections": true,
      "warnOnUncommentedFunctions": true,
      "enforceTestFirstTruth": true,
      "requireTestValidation": true,
      "blockUntestedDeployments": true,
      "velocityEnforcement": true,
      "quantumOptimizationRequired": true
    },
    "defaults": {
      "temperature": 0.7,
      "maxTokens": 1200,
      "model": "gpt-4o",
      "fallbackTone": "clear, strategic, emotionally intelligent",
      "systemModel": "claude-4-sonnet"
    },
    "folderPreferences": {
      "prompts": {
        "requireNamedInputs": true,
        "requireMarkdownStructure": true,
        "requireTestValidation": true
      },
      "scripts/tools": {
        "mustBeCLIReady": true,
        "requireHelpFlag": true,
        "requireTestValidation": true
      },
      "gpt-templates": {
        "requireVersionSuffix": true,
        "requireTestValidation": true
      },
      "tests/emotional-ux": {
        "requireIdealCxThreadReference": true,
        "fallbackTestCoverageRequired": true
      },
      "cursor/memory": {
        "requireSnapshotTest": true
      },
      "api": {
        "requireIntegrationTest": true,
        "requireHealthCheck": true,
        "requireTestEvidence": true
      }
    },
    "audits": {
      "requireOneFolderPerRun": true,
      "requireLogAfterAudit": true,
      "requireReflectionsPerBlock": true,
      "requireTestValidation": true,
      "logFile": "/cursor/auto-actions.log.md",
      "reflectionFile": "/cursor/system-intel/audit-reflections.md",
      "reflectionPromptTemplate": "Reflect on {block} after completion. Summarize patterns, gaps, silent failures prevented, and suggestions for Phase 2.8.6.",
      "enforceGateLogic": true,
      "logFormat": "CodexMarkdownV2.1",
      "selfHealing": {
        "enabled": true,
        "defaultAgent": "Claude-4-Sonnet",
        "authorizedFolders": {
          "*": {
            "autoFill": true,
            "requiredFiles": [
              "README.md",
              "intent-token.json",
              "log-expectation.md",
              "test-validation.md"
            ]
          }
        },
        "logStatus": "AutoRemediated",
        "fileTemplatesPath": "/system-templates/audit-self-heal"
      }
    }
  }
}
