        "promptType": {
          "type": "Select",
          "constraints": "Optional",
          "description": "Product type",
          "airtableType": "Single select",
          "options": [
            "ad_amplify",
            "blogblitz",
            "profile_makeover",
            "business_plan",
            "email_campaign",
            "site_audit",
            "social_content",
            "reverse_strategy",
            "ai_blueprint",
            "ai_brand_identity",
            "spark_split"
          ]
        },
        "dateRange": {
          "type": "Text",
          "constraints": "Optional",
          "description": "Max 50 characters",
          "airtableType": "Single line text"
        },
        "totalSessions": {
          "type": "Number",
          "constraints": "Optional",
          "description": "Integer, no decimals",
          "airtableType": "Number",
          "precision": 0
        },
        "averageTrustScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "averageResonanceScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "totalTokensUsed": {
          "type": "Number",
          "constraints": "Optional",
          "description": "Integer, no decimals",
          "airtableType": "Number",
          "precision": 0
        },
        "totalCostUSD": {
          "type": "Number",
          "constraints": "Optional",
          "description": "4 decimal places (0.0000)",
          "airtableType": "Currency",
          "precision": 4
        },
        "computedAt": {
          "type": "DateTime",
          "constraints": "Auto-populated",
          "description": "Computation timestamp",
          "airtableType": "Created time"
        }
      },
