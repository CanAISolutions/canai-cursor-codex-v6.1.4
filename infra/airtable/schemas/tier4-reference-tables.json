    "AnalyticsAggregates": {
      "description": "Pre-computed analytics for performance",
      "purpose": "Store pre-calculated analytics data for faster reporting and dashboards",
      "tier": "Reference",
      "priority": "Low",
      "fields": {
        "id": {
          "type": "Text",
          "constraints": "Primary Key, Required",
          "description": "Auto-generated unique ID",
          "airtableType": "Single line text"
