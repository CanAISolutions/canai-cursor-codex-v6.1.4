          "type": "Checkbox",
          "constraints": "Default: True",
          "description": "Boolean",
          "airtableType": "Checkbox"
        },
        "deletionRequested": {
          "type": "Checkbox",
          "constraints": "Default: False",
          "description": "Boolean",
          "airtableType": "Checkbox"
        },
        "createdAt": {
          "type": "DateTime",
          "constraints": "Auto-populated",
          "description": "System timestamp",
          "airtableType": "Created time"
        },
        "updatedAt": {
          "type": "DateTime",
          "constraints": "Auto-populated",
          "description": "System timestamp",
          "airtableType": "Last modified time"
        }
