        "trustScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "resonanceScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "smartPromptScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "emotionalDepth": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "aweScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "ownershipScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "wonderScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "calmScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
        "powerScore": {
          "type": "Number",
          "constraints": "Optional",
          "description": "2 decimal places (0.00), Range: 0-1",
          "airtableType": "Number",
          "precision": 2,
          "range": [0, 1]
        },
