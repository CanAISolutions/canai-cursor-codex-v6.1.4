{
  "metadata": {
    "tier": "Tier 1 - Core Tables",
    "description": "Universal data capture and core analytics tables",
    "tableCount": 3,
    "purpose": "Foundation tables for all prompt interactions and analytics",
    "version": "v4.0.0",
    "lastUpdated": "2025-01-27"
  },
  "tables": {
    "PromptLogs": {
      "description": "Universal prompt tracking for all 11 products",
      "purpose": "Central logging table for all prompt interactions with flexible JSON storage",
      "tier": "Core",
      "priority": "Critical",
      "fields": {
        "id": {
          "type": "Text",
          "constraints": "Primary Key, Required",
          "description": "Auto-generated unique ID",
          "airtableType": "Single line text"
        },
        "timestamp": {
          "type": "DateTime",
          "constraints": "Required",
          "description": "Auto-populated on creation",
          "airtableType": "Date and time"
        },
        "sessionId": {
          "type": "Text",
          "constraints": "Required",
          "description": "Links to SessionAnalytics",
          "airtableType": "Single line text",
          "relationship": "SessionAnalytics.sessionId"
        },
        "userId": {
          "type": "Text",
          "constraints": "Required",
          "description": "Links to UserContext",
          "airtableType": "Single line text",
          "relationship": "UserContext.userId"
        },
        "promptType": {
          "type": "Select",
          "constraints": "Required",
          "description": "Type of prompt executed",
          "airtableType": "Single select",
          "options": [
            "ad_amplify",
            "blogblitz",
            "profile_makeover",
            "business_plan",
            "email_campaign",
            "site_audit",
            "social_content",
            "reverse_strategy",
            "ai_blueprint",
            "ai_brand_identity",
            "spark_split"
          ],
          "relationship": "PromptTypes.promptType"
        },
        "inputFields": {
          "type": "JSON",
          "constraints": "Required",
          "description": "Stores any of the 11 interface types",
          "airtableType": "Long text",
          "note": "JSON string containing flexible input data"
        },
        "output": {
          "type": "JSON",
          "constraints": "Optional",
          "description": "Generated content",
          "airtableType": "Long text",
          "note": "JSON string containing output data"
        },
        "tokensUsed": {
          "type": "Number",
          "constraints": "Optional",
          "description": "Integer, no decimals",
          "airtableType": "Number",
          "precision": 0
