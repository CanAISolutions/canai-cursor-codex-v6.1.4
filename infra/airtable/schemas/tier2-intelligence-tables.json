{
  "tier": "Tier 2 - Intelligence",
  "description": "Intelligence and analytics tables for user insights, emotional tracking, trust metrics, and performance monitoring",
  "tables": {
    "GoldmineOutput": {
      "description": "Stores high-value prompt outputs for reuse and analysis",
      "fields": {
        "recordId": {
          "type": "Single line text",
          "required": true,
          "description": "Unique identifier for the goldmine record",
          "validation": "Must be unique across all records"
        },
        "sessionId": {
          "type": "Single line text",
          "required": true,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "userId": {
          "type": "Single line text",
          "required": false,
          "description": "User identifier for personalization"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt that generated this output"
        },
        "outputContent": {
          "type": "Long text",
          "required": false,
          "description": "The actual output content for reuse"
        },
        "outputHash": {
          "type": "Single line text",
          "required": true,
          "description": "Hash of output content for deduplication",
          "validation": "Must be unique"
        },
        "resonanceScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "How well the output resonates (0-1)",
          "range": [0, 1]
        },
        "trustScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Trust score for this output (0-1)",
          "range": [0, 1]
        },
        "industryCluster": {
          "type": "Single line text",
          "required": false,
          "description": "Industry category for clustering"
        },
        "intentSummary": {
          "type": "Single line text",
          "required": false,
          "description": "Summary of user intent"
        },
        "sparkConcept": {
          "type": "Single line text",
          "required": false,
          "description": "Key spark concept identified"
        },
        "reuseCategory": {
          "type": "Single select",
          "required": false,
          "options": ["template", "inspiration", "framework", "example", "case_study"],
          "description": "How this output can be reused"
        },
        "reusePotential": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Potential for reuse (0-10)"
        },
        "compoundValue": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Value when combined with other outputs"
        },
        "emotionalTone": {
          "type": "Single line text",
          "required": false,
          "description": "Emotional tone of the output"
        },
        "emotionalEnergy": {
          "type": "Single line text",
          "required": false,
          "description": "Energy level of the output"
        },
        "emotionalStyle": {
          "type": "Single line text",
          "required": false,
          "description": "Style characteristics"
        },
        "emotionalVocabulary": {
          "type": "Single line text",
          "required": false,
          "description": "Vocabulary characteristics"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["outputHash", "sessionId", "promptType", "industryCluster"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId"
      }
    },
    "UserContext": {
      "description": "Comprehensive user context and personalization data",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique user context identifier"
        },
        "userId": {
          "type": "Single line text",
          "required": true,
          "description": "User identifier",
          "validation": "Must be unique"
        },
        "email": {
          "type": "Email",
          "required": false,
          "description": "User email address"
        },
        "timezone": {
          "type": "Single line text",
          "required": false,
          "description": "User timezone"
        },
        "totalSessions": {
          "type": "Number",
          "required": true,
          "description": "Total number of sessions"
        },
        "preferredProducts": {
          "type": "Multiple select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "User's preferred products"
        },
        "preferredTone": {
          "type": "Single select",
          "required": false,
          "options": ["professional", "casual", "friendly", "authoritative", "creative", "technical"],
          "description": "User's preferred communication tone"
        },
        "industryFocus": {
          "type": "Multiple select",
          "required": false,
          "options": ["technology", "healthcare", "finance", "education", "retail", "manufacturing", "consulting", "marketing", "real_estate", "other"],
          "description": "User's industry focus areas"
        },
        "businessGoals": {
          "type": "Multiple select",
          "required": false,
          "options": ["growth", "efficiency", "innovation", "customer_acquisition", "brand_building", "cost_reduction", "market_expansion"],
          "description": "User's business goals"
        },
        "personalizationScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "How well we understand this user (0-1)",
          "range": [0, 1]
        },
        "emotionalBaseline": {
          "type": "Single line text",
          "required": false,
          "description": "User's emotional baseline state"
        },
        "trustScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "User's trust score (0-1)",
          "range": [0, 1]
        },
        "lifetimeValue": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Estimated lifetime value"
        },
        "churnRisk": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Risk of user churning (0-1)",
          "range": [0, 1]
        },
        "engagementTrend": {
          "type": "Single select",
          "required": false,
          "options": ["rising", "stable", "declining"],
          "description": "User engagement trend"
        },
        "preferences": {
          "type": "Long text",
          "required": false,
          "description": "JSON object with user preferences"
        },
        "emotionalProfile": {
          "type": "Long text",
          "required": false,
          "description": "JSON object with emotional profile data"
        },
        "sparkResonance": {
          "type": "Long text",
          "required": false,
          "description": "JSON object with spark resonance data"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        },
        "updatedAt": {
          "type": "Date",
          "required": true,
          "description": "Record last update timestamp"
        }
      },
      "indexes": ["userId", "email", "engagementTrend"],
      "relationships": {
        "SessionAnalytics": "userId -> SessionAnalytics.userId"
      }
    },
    "EmotionalIntelligence": {
      "description": "Tracks emotional intelligence metrics and 5-axis emotional compass",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique emotional intelligence record identifier"
        },
        "sessionId": {
          "type": "Single line text",
          "required": true,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "userId": {
          "type": "Single line text",
          "required": false,
          "description": "User identifier"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt"
        },
        "emotionalState": {
          "type": "Single line text",
          "required": false,
          "description": "Current emotional state"
        },
        "aweScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Awe axis score (0-10)"
        },
        "ownershipScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Ownership axis score (0-10)"
        },
        "wonderScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Wonder axis score (0-10)"
        },
        "calmScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Calm axis score (0-10)"
        },
        "powerScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Power axis score (0-10)"
        },
        "overallResonance": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Overall emotional resonance (0-10)"
        },
        "trustScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Trust score for this interaction (0-10)"
        },
        "confidenceScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Confidence in emotional assessment (0-10)"
        },
        "timestamp": {
          "type": "Date",
          "required": true,
          "description": "When the emotional assessment was made"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["sessionId", "userId", "promptType", "timestamp"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId",
        "UserContext": "userId -> UserContext.userId"
      }
    },
    "TrustMetrics": {
      "description": "Detailed trust scoring and tracking system",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique trust metrics record identifier"
        },
        "sessionId": {
          "type": "Single line text",
          "required": true,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "userId": {
          "type": "Single line text",
          "required": false,
          "description": "User identifier"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt"
        },
        "trustScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Current trust score (0-10)"
        },
        "previousScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Previous trust score for comparison"
        },
        "trustDelta": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Change in trust score"
        },
        "source": {
          "type": "Single select",
          "required": false,
          "options": ["user_feedback", "behavioral_analysis", "output_quality", "response_time", "error_rate", "transparency"],
          "description": "Source of trust measurement"
        },
        "component": {
          "type": "Single select",
          "required": false,
          "options": ["competence", "reliability", "transparency", "benevolence", "predictability"],
          "description": "Trust component being measured"
        },
        "reason": {
          "type": "Single line text",
          "required": false,
          "description": "Reason for trust score change"
        },
        "confidenceScore": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Confidence in trust assessment (0-10)"
        },
        "timestamp": {
          "type": "Date",
          "required": true,
          "description": "When the trust measurement was taken"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["sessionId", "userId", "promptType", "source", "timestamp"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId",
        "UserContext": "userId -> UserContext.userId"
      }
    },
    "PerformanceMetrics": {
      "description": "System performance tracking and optimization data",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique performance metrics record identifier"
        },
        "sessionId": {
          "type": "Single line text",
          "required": false,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt"
        },
        "apiCallId": {
          "type": "Single line text",
          "required": false,
          "description": "Unique API call identifier"
        },
        "timestamp": {
          "type": "Date",
          "required": true,
          "description": "When the performance measurement was taken"
        },
        "responseTime": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Response time in milliseconds"
        },
        "tokensUsed": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Number of tokens used"
        },
        "cost": {
          "type": "Number",
          "required": false,
          "precision": 4,
          "description": "Cost in USD"
        },
        "modelUsed": {
          "type": "Single select",
          "required": false,
          "options": ["gpt-4o", "claude-4-sonnet", "gpt-4o-mini", "claude-3-haiku"],
          "description": "AI model used"
        },
        "success": {
          "type": "Checkbox",
          "required": false,
          "description": "Whether the operation was successful"
        },
        "errorMessage": {
          "type": "Long text",
          "required": false,
          "description": "Error message if operation failed"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["sessionId", "promptType", "modelUsed", "timestamp"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId"
      }
    }
  },
  "importOrder": [
    "UserContext",
    "EmotionalIntelligence", 
    "TrustMetrics",
    "PerformanceMetrics",
    "GoldmineOutput"
  ],
  "dependencies": {
    "UserContext": [],
    "EmotionalIntelligence": ["SessionAnalytics", "UserContext"],
    "TrustMetrics": ["SessionAnalytics", "UserContext"],
    "PerformanceMetrics": ["SessionAnalytics"],
    "GoldmineOutput": ["SessionAnalytics"]
  },
  "notes": {
    "purpose": "Intelligence layer for user insights, emotional tracking, trust building, and performance optimization",
    "keyFeatures": [
      "5-Axis Emotional Compass tracking",
      "Comprehensive trust scoring system",
      "User context and personalization",
      "High-value output goldmine",
      "Performance optimization metrics"
    ],
    "integrations": [
      "Links to Tier 1 Core tables for session data",
      "Supports Tier 3 Integration for webhooks",
      "References Tier 4 Reference tables for configurations"
    ]
  }
} 