{
  "tier": "Tier 3 - Integration",
  "description": "Integration infrastructure tables for webhooks, sync operations, error tracking, processing results, and system health monitoring",
  "tables": {
    "WebhookLogs": {
      "description": "Comprehensive webhook delivery tracking and monitoring",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique webhook log identifier"
        },
        "sessionId": {
          "type": "Single line text",
          "required": false,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt that triggered webhook"
        },
        "webhookType": {
          "type": "Single select",
          "required": true,
          "options": ["make_com", "zapier", "airtable_sync", "analytics_push", "notification", "backup", "audit_log"],
          "description": "Type of webhook being sent"
        },
        "payload": {
          "type": "Long text",
          "required": false,
          "description": "JSON payload sent to webhook"
        },
        "deliveryStatus": {
          "type": "Single select",
          "required": false,
          "options": ["success", "failed", "pending", "retry"],
          "description": "Current delivery status"
        },
        "responseCode": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "HTTP response code received"
        },
        "responseTime": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Response time in milliseconds"
        },
        "retryCount": {
          "type": "Number",
          "required": true,
          "precision": 0,
          "description": "Number of retry attempts"
        },
        "timestamp": {
          "type": "Date",
          "required": true,
          "description": "When the webhook was sent"
        },
        "errorMessage": {
          "type": "Long text",
          "required": false,
          "description": "Error message if delivery failed"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["sessionId", "webhookType", "deliveryStatus", "timestamp"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId"
      }
    },
    "AirtableSync": {
      "description": "Airtable synchronization operations and status tracking",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique sync operation identifier"
        },
        "sourceTable": {
          "type": "Single select",
          "required": true,
          "options": ["PromptLogs", "SessionAnalytics", "SparkSplitAnalytics", "GoldmineOutput", "UserContext", "EmotionalIntelligence", "TrustMetrics", "PerformanceMetrics", "WebhookLogs", "ErrorLogs", "ProcessingResults", "SystemHealth", "PromptTypes", "EmotionalStates", "TrustFactors", "SystemConfigs", "AnalyticsAggregates"],
          "description": "Source table being synchronized"
        },
        "recordId": {
          "type": "Single line text",
          "required": true,
          "description": "ID of the record being synchronized"
        },
        "syncStatus": {
          "type": "Single select",
          "required": false,
          "options": ["pending", "success", "failed", "retry"],
          "description": "Current synchronization status"
        },
        "lastSyncAttempt": {
          "type": "Date",
          "required": false,
          "description": "When the last sync attempt was made"
        },
        "syncDuration": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Sync duration in milliseconds"
        },
        "errorMessage": {
          "type": "Long text",
          "required": false,
          "description": "Error message if sync failed"
        },
        "retryCount": {
          "type": "Number",
          "required": true,
          "precision": 0,
          "description": "Number of retry attempts"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        },
        "updatedAt": {
          "type": "Date",
          "required": true,
          "description": "Record last update timestamp"
        }
      },
      "indexes": ["sourceTable", "syncStatus", "lastSyncAttempt"],
      "relationships": {}
    },
    "ErrorLogs": {
      "description": "Comprehensive error tracking and debugging system",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique error log identifier"
        },
        "sessionId": {
          "type": "Single line text",
          "required": false,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt when error occurred"
        },
        "errorType": {
          "type": "Single select",
          "required": false,
          "options": ["api_error", "validation_error", "timeout_error", "rate_limit", "authentication_error", "processing_error", "webhook_error", "sync_error", "system_error"],
          "description": "Category of error"
        },
        "errorMessage": {
          "type": "Long text",
          "required": false,
          "description": "Detailed error message"
        },
        "stackTrace": {
          "type": "Long text",
          "required": false,
          "description": "Stack trace for debugging"
        },
        "severity": {
          "type": "Single select",
          "required": false,
          "options": ["low", "medium", "high", "critical"],
          "description": "Error severity level"
        },
        "resolved": {
          "type": "Checkbox",
          "required": false,
          "description": "Whether the error has been resolved"
        },
        "timestamp": {
          "type": "Date",
          "required": true,
          "description": "When the error occurred"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["sessionId", "errorType", "severity", "resolved", "timestamp"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId"
      }
    },
    "ProcessingResults": {
      "description": "Processing pipeline results and status tracking",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique processing result identifier"
        },
        "sessionId": {
          "type": "Single line text",
          "required": false,
          "description": "Links to SessionAnalytics table",
          "relationship": "SessionAnalytics.sessionId"
        },
        "promptType": {
          "type": "Single select",
          "required": false,
          "options": ["ad_amplify", "blogblitz", "profile_makeover", "business_plan", "email_campaign", "site_audit", "social_content", "reverse_strategy", "ai_blueprint", "ai_brand_identity", "spark_split"],
          "description": "Type of prompt being processed"
        },
        "processingStage": {
          "type": "Single select",
          "required": false,
          "options": ["validation", "preprocessing", "ai_generation", "postprocessing", "formatting", "quality_check", "delivery"],
          "description": "Current processing stage"
        },
        "status": {
          "type": "Single select",
          "required": false,
          "options": ["pending", "processing", "completed", "failed"],
          "description": "Processing status"
        },
        "startTime": {
          "type": "Date",
          "required": false,
          "description": "When processing started"
        },
        "endTime": {
          "type": "Date",
          "required": false,
          "description": "When processing completed"
        },
        "duration": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Processing duration in milliseconds"
        },
        "resultData": {
          "type": "Long text",
          "required": false,
          "description": "JSON result data from processing"
        },
        "errorMessage": {
          "type": "Long text",
          "required": false,
          "description": "Error message if processing failed"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["sessionId", "promptType", "processingStage", "status"],
      "relationships": {
        "SessionAnalytics": "sessionId -> SessionAnalytics.sessionId"
      }
    },
    "SystemHealth": {
      "description": "System health monitoring and alerting",
      "fields": {
        "id": {
          "type": "Single line text",
          "required": true,
          "description": "Unique system health record identifier"
        },
        "component": {
          "type": "Single select",
          "required": true,
          "options": ["api_gateway", "ai_service", "database", "webhook_service", "sync_service", "auth_service", "file_storage", "cache_service", "monitoring"],
          "description": "System component being monitored"
        },
        "healthStatus": {
          "type": "Single select",
          "required": false,
          "options": ["healthy", "warning", "critical", "down"],
          "description": "Current health status"
        },
        "responseTime": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Component response time in milliseconds"
        },
        "errorRate": {
          "type": "Number",
          "required": false,
          "precision": 2,
          "description": "Error rate percentage"
        },
        "throughput": {
          "type": "Number",
          "required": false,
          "precision": 0,
          "description": "Requests per minute"
        },
        "lastCheck": {
          "type": "Date",
          "required": true,
          "description": "When the health check was performed"
        },
        "alertTriggered": {
          "type": "Checkbox",
          "required": false,
          "description": "Whether an alert was triggered"
        },
        "createdAt": {
          "type": "Date",
          "required": true,
          "description": "Record creation timestamp"
        }
      },
      "indexes": ["component", "healthStatus", "lastCheck"],
      "relationships": {}
    }
  },
  "importOrder": [
    "SystemHealth",
    "ErrorLogs",
    "ProcessingResults",
    "AirtableSync",
    "WebhookLogs"
  ],
  "dependencies": {
    "SystemHealth": [],
    "ErrorLogs": ["SessionAnalytics"],
    "ProcessingResults": ["SessionAnalytics"],
    "AirtableSync": [],
    "WebhookLogs": ["SessionAnalytics"]
  },
  "notes": {
    "purpose": "Integration infrastructure for webhooks, synchronization, error tracking, and system monitoring",
    "keyFeatures": [
      "Comprehensive webhook delivery tracking",
      "Airtable synchronization monitoring",
      "Multi-level error tracking and debugging",
      "Processing pipeline status tracking",
      "Real-time system health monitoring"
    ],
    "integrations": [
      "Make.com webhook integration",
      "Airtable API synchronization",
      "Error alerting and notification systems",
      "Performance monitoring dashboards",
      "Automated health checks"
    ]
  }
} 